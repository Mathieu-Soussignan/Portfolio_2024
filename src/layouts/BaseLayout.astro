				font-size: 0.7rem; font-weight: 800; letter-spacing: 0.15em; color: var(--qp-accent);
				padding: 0.3rem 0.9rem; border-radius: 999px; background: rgba(255,255,255,0.05);
				border: 1px solid var(--qp-accent);
			}

			:global(.qp-title) {
				font-size: 1.4rem; font-weight: 900; color: #fff; text-shadow: 0 0 20px var(--qp-accent);
			}

			:global(.qp-target) { font-size: 0.85rem; color: rgba(255, 255, 255, 0.6); }
			:global(.qp-target span) { color: var(--qp-accent); font-weight: 700; }

			:global(.qp-console) {
				width: 100%; text-align: left; background: rgba(0,0,0,0.6);
				border: 1px solid rgba(255,255,255,0.1); border-radius: 8px;
