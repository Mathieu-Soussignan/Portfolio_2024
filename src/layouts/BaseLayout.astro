			/* ========================================
			   🥽 OASIS VR Neural Link Warp Transition
			   ======================================== */
			@keyframes oasisBodyGlitch {
				0% { filter: none; transform: translate(0, 0); }
				20% { filter: invert(0.8) hue-rotate(90deg); transform: translate(-5px, 3px); }
				40% { filter: contrast(200%) saturate(300%); transform: translate(5px, -3px); }
				60% { filter: invert(0.5); transform: translate(-3px, -3px); }
				80% { filter: hue-rotate(180deg); transform: translate(3px, 2px); }
				100% { filter: none; transform: translate(0, 0); }
			}

			:global(#oasis-vr-overlay) {
				position: fixed; inset: 0; z-index: 9999999;
				background: #05070c;
				display: flex; flex-direction: column;
				align-items: center; justify-content: center;
				overflow: hidden;
				opacity: 0; transition: opacity 0.4s ease;
				pointer-events: all;
			}
			:global(#oasis-vr-overlay.oasis-vr-active) { opacity: 1; }

			:global(.oasis-vr-grid) {
				position: absolute; inset: -50%;
				background-image: 
					linear-gradient(rgba(0, 242, 254, 0.25) 1px, transparent 1px),
					linear-gradient(90deg, rgba(197, 97, 246, 0.25) 1px, transparent 1px);
				background-size: 50px 50px;
				transform: perspective(400px) rotateX(60deg);
				animation: vrGridMove 1s linear infinite;
			}
			@keyframes vrGridMove {
				0% { transform: perspective(400px) rotateX(60deg) translateY(0); }
				100% { transform: perspective(400px) rotateX(60deg) translateY(50px); }
			}

			:global(.oasis-vr-tunnel) {
				position: absolute; inset: 0;
				background: radial-gradient(circle at center, transparent 10%, #05070c 80%);
				pointer-events: none;
			}

			:global(.oasis-vr-hud) {
				position: relative; z-index: 2;
				display: flex; flex-direction: column; align-items: center; gap: 1rem;
				padding: 2.5rem; border-radius: 16px;
				background: rgba(10, 14, 23, 0.9);
				border: 1px solid rgba(0, 242, 254, 0.4);
				box-shadow: 0 0 50px rgba(0, 242, 254, 0.3), inset 0 0 30px rgba(197, 97, 246, 0.2);
