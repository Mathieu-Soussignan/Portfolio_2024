			:global(.qp-line) { opacity: 0; animation: qpFadeLine 0.4s forwards; }
			:global(.qp-l1) { animation-delay: 0.2s; }
			:global(.qp-l2) { animation-delay: 0.8s; color: #fff; }
			:global(.qp-l3) { animation-delay: 1.5s; color: #ffd700; font-weight: 800; }
			@keyframes qpFadeLine { to { opacity: 1; } }

			:global(.qp-progress-bar) {
				width: 100%; height: 6px; background: rgba(255,255,255,0.1);
				border-radius: 999px; overflow: hidden; margin-top: 0.5rem;
			}
			:global(.qp-progress-fill) {
				width: 0%; height: 100%; background: var(--qp-accent);
				box-shadow: 0 0 10px var(--qp-accent);
				animation: qpFillBar 2.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
			}
			@keyframes qpFillBar { to { width: 100%; } }

			:global(.qp-streaks) { position: absolute; inset: 0; pointer-events: none; }
			:global(.qp-streak) {
				position: absolute; top: -100px; width: 2px; height: 120px;
				background: linear-gradient(to bottom, transparent, var(--qp-accent), transparent);
				animation: qpStreakDrop 0.8s linear infinite;
			}
			@keyframes qpStreakDrop {
				0% { transform: translateY(-100px); opacity: 0; }
				50% { opacity: 1; }
				100% { transform: translateY(100vh); opacity: 0; }
			}

