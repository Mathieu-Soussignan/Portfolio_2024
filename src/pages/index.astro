---
import { getCollection } from "astro:content";

// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from "../layouts/BaseLayout.astro";

// Component Imports
import CallToAction from "../components/CallToAction.astro";
import Grid from "../components/Grid.astro";
import Icon from "../components/Icon.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";

// Page section components
import ContactCTA from "../components/ContactCTA.astro";
import Skills from "../components/Skills.astro";
import InteractiveTerminal from "../components/InteractiveTerminal.astro";
import TechMarquee from "../components/TechMarquee.astro";

// Content Fetching: List four most recent work projects
const projects = (await getCollection("work"))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);
---

<BaseLayout>
  <div class="stack gap-15 lg:gap-30">
    <div class="wrapper stack gap-12 lg:gap-20">
      
      <!-- HERO GOD TIER SECTION -->
      <header class="god-hero">
        <div class="hero-content">
          <div class="status-badge">
            <span class="status-pulse"></span> DATA ENGINEER & DÉVELOPPEUR IA
          </div>

          <h1 class="hero-title">
            Hello, je m'appelle <br />
            <span class="gradient-text hero-title-shimmer">Mathieu Soussignan</span>
          </h1>

          <div class="hero-tagline-box glass-card">
            <p>
              Data Engineer & Développeur IA chez <span class="highlight-text">Keyrus</span> (Marseille). 
              Je conçois des <span class="gradient-accent-text">architectures Data robustes</span> et des applications Web & IA de bout en bout.
            </p>
          </div>

          <div class="hero-cyber-roles">
            <div class="cyber-chip glass-card">
              <span class="chip-icon">🤖</span>
              <span>Data Engineer & IA</span>
            </div>
            <div class="cyber-chip glass-card">
              <span class="chip-icon">⚡</span>
              <span>Développeur FullStack</span>
            </div>
            <div class="cyber-chip glass-card active-chip">
              <span class="chip-icon">💼</span>
              <span>CDI chez Keyrus</span>
            </div>
          </div>

          <div class="hero-actions">
            <a href="/work/" class="primary-hero-cta">
              <span>Explorer mes projets</span>
              <Icon icon="arrow-right" size="1.2em" />
            </a>
            <a href="mailto:contact@mathieu-soussignan.com" class="secondary-hero-cta glass-card">
              <span>Me contacter</span>
              <Icon icon="paper-plane-tilt" size="1.2em" />
            </a>
          </div>
        </div>

        <!-- GOD TIER PROFILE CARD WITH 3D HOLOGRAM TILT -->
        <div class="hero-profile-showcase">
          <div class="profile-card glass-card tilt-card-3d" id="hero-tilt-card">
            <div class="conic-neon-ring"></div>

            <div class="photo-wrapper layer-base-3d">
              <img
                alt="Mathieu Soussignan - Data Engineer & Développeur IA"
                src="/assets/profil-home.jpg"
                class="profile-img"
              />
              <div class="photo-glow"></div>
              <div class="shine-overlay"></div>
            </div>

            <div class="floating-tech tech-top-left glass-card layer-depth-3d">
              <span>🐍</span> Python & PyTorch
            </div>
            <div class="floating-tech tech-top-right glass-card layer-depth-3d">
              <span>🗄️</span> Data ETL & SQL
            </div>
            <div class="floating-tech tech-bottom-right glass-card layer-depth-3d">
              <span>⚡</span> React & FastAPI
            </div>

            <div class="profile-card-footer layer-base-3d">
              <span class="live-dot"></span>
              <span><strong>CDI chez Keyrus</strong> • Marseille / Aix</span>
            </div>
          </div>
        </div>
      </header>

      <script>
        // 3D Parallax Tilt & Light Shine Effect
        const tiltCard = document.getElementById('hero-tilt-card');
        if (tiltCard) {
          tiltCard.addEventListener('mousemove', (e) => {
            const rect = tiltCard.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            const rotateX = ((y - centerY) / centerY) * -16;
            const rotateY = ((x - centerX) / centerX) * 16;
            
            tiltCard.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.05, 1.05, 1.05)`;
            tiltCard.style.transition = 'none';

            const shine = tiltCard.querySelector('.shine-overlay') as HTMLElement;
            if (shine) {
              shine.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0) 65%)`;
            }
          });

          tiltCard.addEventListener('mouseleave', () => {
            tiltCard.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
            tiltCard.style.transition = 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
            const shine = tiltCard.querySelector('.shine-overlay') as HTMLElement;
            if (shine) {
              shine.style.background = 'none';
            }
          });
        }

          // =============================================
          // 🐇 EASTER EGG #5 — Holographic White Rabbit & Matrix Breach
          // =============================================
          (() => {
            const rabbit = document.createElement('div');
            rabbit.id = 'white-rabbit';
            rabbit.innerHTML = `
              <div class="rabbit-body">🐇</div>
              <div class="rabbit-aura"></div>
              <div class="rabbit-label">SUIS-MOI...</div>
            `;
            rabbit.style.cssText = `
              position: fixed;
              z-index: 99999;
              cursor: pointer;
              pointer-events: all;
              opacity: 0;
              transform: scale(0.4) rotate(0deg);
              transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                          transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                          left 2.5s ease-in-out,
                          top 2.5s ease-in-out;
              user-select: none;
            `;
            document.body.appendChild(rabbit);

            let rabbitClicked = false;
            let rabbitInterval: ReturnType<typeof setInterval> | null = null;

            const positions = [
              { left: '12%', top: '22%' },
              { left: '75%', top: '30%' },
              { left: '25%', top: '65%' },
              { left: '82%', top: '18%' },
              { left: '15%', top: '75%' },
              { left: '65%', top: '60%' },
              { left: '45%', top: '85%' },
            ];

            // Particle Trail (0s and 1s)
            function spawnBinaryParticle(x: number, y: number) {
              if (Math.random() > 0.4) return;
              const p = document.createElement('span');
              p.className = 'rabbit-binary-particle';
              p.textContent = Math.random() > 0.5 ? '1' : '0';
              p.style.cssText = `
                position: fixed;
                left: ${x + (Math.random() * 30 - 15)}px;
                top: ${y + (Math.random() * 30 - 15)}px;
                z-index: 99998;
                font-family: 'Fira Code', monospace;
                font-size: 0.8rem;
                font-weight: 800;
                color: #00ff66;
                text-shadow: 0 0 8px #00ff66;
                pointer-events: none;
                animation: rabbitParticleFade 1.2s ease-out forwards;
              `;
              document.body.appendChild(p);
              setTimeout(() => p.remove(), 1200);
            }

            function showRabbit(index: number) {
              if (rabbitClicked) return;
              const pos = positions[index % positions.length];
              const rot = -15 + Math.random() * 30;
              rabbit.style.left = pos.left;
              rabbit.style.top = pos.top;
              rabbit.style.transform = `scale(1) rotate(${rot}deg)`;
              rabbit.style.opacity = '1';

              // Particle trail burst
              const rect = rabbit.getBoundingClientRect();
              for (let i = 0; i < 4; i++) {
                spawnBinaryParticle(rect.left + 20, rect.top + 20);
              }
            }

            function hideRabbit() {
              if (rabbitClicked) return;
              rabbit.style.opacity = '0';
              rabbit.style.transform = 'scale(0.3) rotate(0deg)';
            }

            // FULL MATRIX BREACH TRANSITION ON CLICK
            rabbit.addEventListener('click', (e) => {
              e.stopPropagation();
              if (rabbitClicked) return;
              rabbitClicked = true;

              if (rabbitInterval) clearInterval(rabbitInterval);

              // 1. Cyber Glitch Sound
              try {
                const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
                const o = ctx.createOscillator();
                const g = ctx.createGain();
                o.type = 'sawtooth';
                o.frequency.setValueAtTime(200, ctx.currentTime);
                o.frequency.linearRampToValueAtTime(1200, ctx.currentTime + 0.4);
                o.frequency.setValueAtTime(300, ctx.currentTime + 0.5);
                o.frequency.linearRampToValueAtTime(1800, ctx.currentTime + 1.0);
                g.gain.setValueAtTime(0.15, ctx.currentTime);
                g.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.2);
                o.connect(g); g.connect(ctx.destination);
                o.start(); o.stop(ctx.currentTime + 1.2);
              } catch(_err) {}

              // 2. Rabbit Explosion Animation
              rabbit.style.transform = 'scale(4) rotate(360deg)';
              rabbit.style.opacity = '0';
              rabbit.style.filter = 'drop-shadow(0 0 80px #00ff66)';

              // 3. Matrix Breach Full-Screen Overlay & Digital Rain Canvas
              const breach = document.createElement('div');
              breach.id = 'matrix-breach-overlay';
              breach.innerHTML = `
                <canvas id="matrix-rain-canvas"></canvas>
                <div class="mb-content">
                  <div class="mb-terminal">
                    <div class="mb-line mb-l1">> WAKE UP, NEO...</div>
                    <div class="mb-line mb-l2">> THE MATRIX HAS YOU.</div>
                    <div class="mb-line mb-l3">> FOLLOW THE WHITE RABBIT.</div>
                    <div class="mb-status">🐇 TÉLÉPORTATION DANS LA MATRICE EN COURS...</div>
                  </div>
                </div>
              `;
              document.body.appendChild(breach);
              requestAnimationFrame(() => breach.classList.add('mb-active'));

              // Start Canvas Katakana Rain
              const canvas = document.getElementById('matrix-rain-canvas') as HTMLCanvasElement;
              if (canvas) {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
                const cctx = canvas.getContext('2d')!;
                const chars = '01アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン';
                const fontSize = 16;
                const columns = Math.floor(canvas.width / fontSize);
                const drops: number[] = Array(columns).fill(1);

                function drawRain() {
                  cctx.fillStyle = 'rgba(5, 7, 12, 0.15)';
                  cctx.fillRect(0, 0, canvas.width, canvas.height);
                  cctx.fillStyle = '#00ff66';
                  cctx.font = `${fontSize}px monospace`;

                  for (let i = 0; i < drops.length; i++) {
                    const text = chars[Math.floor(Math.random() * chars.length)];
                    cctx.fillText(text, i * fontSize, drops[i] * fontSize);
                    if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) {
                      drops[i] = 0;
                    }
                    drops[i]++;
                  }
                }
                const rainInterval = setInterval(drawRain, 33);
                setTimeout(() => clearInterval(rainInterval), 2500);
              }

              // Redirect after 2.4s of epic Matrix Breach
              setTimeout(() => {
                window.location.href = '/easter-egg/hack/';
              }, 2400);
            });

            // Start rabbit sequence
            function startRabbitSequence() {
              if (rabbitClicked) return;
              setTimeout(() => {
                if (rabbitClicked) return;
                showRabbit(0);
                setTimeout(() => {
                  hideRabbit();
                  setTimeout(() => {
                    if (rabbitClicked) return;
                    showRabbit(1);
                    setTimeout(() => {
                      hideRabbit();
                      if (!rabbitClicked) {
                        rabbitInterval = setInterval(() => {
                          if (rabbitClicked) {
                            if (rabbitInterval) clearInterval(rabbitInterval);
                            return;
                          }
                          const idx = Math.floor(Math.random() * positions.length);
                          showRabbit(idx);
                          setTimeout(() => {
                            hideRabbit();
                          }, 2000);
                        }, 9000);
                      }
                    }, 2500);
                  }, 3000);
                }, 2500);
              }, 4000);
            }

            if (document.readyState === 'complete') {
              startRabbitSequence();
            } else {
              window.addEventListener('load', startRabbitSequence);
            }
          })();

          // =============================================
          // 🥚 EASTER EGG #4 — 7 Clicks → Holographic Card
          // =============================================
        (() => {
          const profileImg = document.querySelector('.profile-img') as HTMLElement;
          if (!profileImg) return;
          
          let clickCount = 0;
          let clickTimer: ReturnType<typeof setTimeout> | null = null;
          const REQUIRED_CLICKS = 7;
          let cardShown = false;

          profileImg.addEventListener('click', (e) => {
            e.stopPropagation();
            if (cardShown) return;
            
            clickCount++;
            
            if (clickTimer) clearTimeout(clickTimer);
            clickTimer = setTimeout(() => { clickCount = 0; }, 2000);

            // Visual feedback — small pulse on each click
            profileImg.style.transition = 'transform 0.15s ease';
            profileImg.style.transform = 'scale(1.05)';
            setTimeout(() => { profileImg.style.transform = 'scale(1)'; }, 150);

            // Show subtle counter after 3 clicks
            if (clickCount >= 3 && clickCount < REQUIRED_CLICKS) {
              (window as any).showToast?.(`🔮 ${clickCount}/${REQUIRED_CLICKS}...`);
            }

            if (clickCount >= REQUIRED_CLICKS) {
              clickCount = 0;
              cardShown = true;
              showHolographicCard();
            }
          });

          function showHolographicCard() {
            // Flash effect
            const flash = document.createElement('div');
            flash.style.cssText = 'position:fixed;inset:0;z-index:999998;background:#ffffff;opacity:1;transition:opacity 0.5s ease;pointer-events:none;';
            document.body.appendChild(flash);
            requestAnimationFrame(() => { flash.style.opacity = '0'; });
            setTimeout(() => flash.remove(), 500);

            // Overlay
            const overlay = document.createElement('div');
            overlay.id = 'holo-overlay';
            overlay.innerHTML = `
              <div class="holo-backdrop"></div>
              <div class="holo-card-container">
                <div class="holo-card" id="holo-card-el">
                  <!-- FRONT -->
                  <div class="holo-face holo-front">
                    <div class="holo-shine"></div>
                    <div class="holo-rainbow"></div>
                    <div class="holo-rarity">★★★★★ LÉGENDAIRE</div>
                    <div class="holo-photo">
                      <img src="/assets/profil-home.jpg" alt="Mathieu Soussignan" />
                    </div>
                    <div class="holo-name">MATHIEU SOUSSIGNAN</div>
                    <div class="holo-class">「 DATA MAGE — RANG S++ 」</div>
                    <div class="holo-desc">Data Engineer & Développeur IA chez Keyrus. Architecte de solutions intelligentes & créateur de SaaS d'élite.</div>
                    <div class="holo-flip-hint">🔄 Cliquer pour retourner</div>
                  </div>
                  <!-- BACK -->
                  <div class="holo-face holo-back">
                    <div class="holo-shine"></div>
                    <div class="holo-rainbow"></div>
                    <h3 class="holo-stats-title">⚔️ STATISTIQUES</h3>
                    <div class="holo-stats">
                      <div class="holo-stat-row"><span>🐍 Force (Python)</span><div class="holo-stat-bar"><div style="width:95%"></div></div><span>95</span></div>
                      <div class="holo-stat-row"><span>🧠 Intelligence (IA/ML)</span><div class="holo-stat-bar"><div style="width:85%"></div></div><span>85</span></div>
                      <div class="holo-stat-row"><span>⚡ Agilité (React)</span><div class="holo-stat-bar"><div style="width:88%"></div></div><span>88</span></div>
                      <div class="holo-stat-row"><span>🗄️ Sagesse (SQL/Data)</span><div class="holo-stat-bar"><div style="width:90%"></div></div><span>90</span></div>
                      <div class="holo-stat-row"><span>🐳 Endurance (DevOps)</span><div class="holo-stat-bar"><div style="width:75%"></div></div><span>75</span></div>
                    </div>
                    <h3 class="holo-stats-title">🏆 ACHIEVEMENTS</h3>
                    <div class="holo-achievements">
                      <span class="holo-badge">🚀 Premier SaaS en Prod</span>
                      <span class="holo-badge">✅ 78/78 Tests Passés</span>
                      <span class="holo-badge">🔄 Reconversion Réussie</span>
                      <span class="holo-badge">🤖 Mistral AI Intégré</span>
                      <span class="holo-badge">📊 Data Pipelines Master</span>
                    </div>
                    <div class="holo-flip-hint">🔄 Cliquer pour retourner</div>
                  </div>
                </div>
              </div>
              <div class="holo-actions">
                <button id="holo-collect-btn">💎 Collectionner cette carte</button>
                <button id="holo-close-btn">✕ Fermer</button>
              </div>
              <div class="holo-particles" id="holo-particles"></div>
            `;
            document.body.appendChild(overlay);

            // Particles
            const particleContainer = document.getElementById('holo-particles')!;
            for (let i = 0; i < 30; i++) {
              const p = document.createElement('div');
              p.className = 'holo-particle';
              p.style.cssText = `
                left:${Math.random()*100}%;
                top:${Math.random()*100}%;
                width:${2+Math.random()*4}px;
                height:${2+Math.random()*4}px;
                animation-delay:${Math.random()*3}s;
                animation-duration:${2+Math.random()*3}s;
              `;
              particleContainer.appendChild(p);
            }

            requestAnimationFrame(() => overlay.classList.add('holo-active'));

            // Card flip
            const card = document.getElementById('holo-card-el')!;
            card.addEventListener('click', () => {
              card.classList.toggle('holo-flipped');
            });

            // Parallax on mouse move
            overlay.addEventListener('mousemove', (e) => {
              const rect = card.getBoundingClientRect();
              const centerX = rect.left + rect.width / 2;
              const centerY = rect.top + rect.height / 2;
              const rotateY = ((e.clientX - centerX) / (window.innerWidth / 2)) * 15;
              const rotateX = ((e.clientY - centerY) / (window.innerHeight / 2)) * -10;
              card.style.setProperty('--rx', `${rotateX}deg`);
              card.style.setProperty('--ry', `${rotateY}deg`);
            });

            // Collect
            document.getElementById('holo-collect-btn')?.addEventListener('click', () => {
              localStorage.setItem('holo-card-collected', 'true');
              (window as any).showToast?.('💎 Carte Légendaire ajoutée à ta collection !');
            });

            // Close
            document.getElementById('holo-close-btn')?.addEventListener('click', () => {
              overlay.classList.remove('holo-active');
              setTimeout(() => { overlay.remove(); cardShown = false; }, 500);
            });
          }
        })();
      </script>

      <!-- TERMINAL SHOWCASE -->
      <section class="terminal-showcase-section">
        <div class="terminal-section-header">
          <h3>💻 Console & Terminal Interactif</h3>
          <p>Explorez mon profil et mes compétences en tapant des commandes ou en cliquant sur les raccourcis.</p>
        </div>
        <div class="terminal-wrapper">
          <InteractiveTerminal />
        </div>
      </section>

      <TechMarquee />

      <Skills />
    </div>

    <main class="wrapper stack gap-20 lg:gap-48">
      <section class="section with-background with-cta">
        <header class="section-header stack gap-2 lg:gap-4">
          <h3>Mes derniers projets</h3>
          <p>
            Découvrez mes derniers projets, réalisés pour des clients ou pour
            moi-même.
          </p>
        </header>

        <div class="gallery">
          <Grid variant="offset">
            {
              projects.map((project) => (
                <li>
                  <PortfolioPreview project={project} />
                </li>
              ))
            }
          </Grid>
        </div>

        <div class="cta">
          <CallToAction href="/work/">
            Tous mes projets
            <Icon icon="arrow-right" size="1.2em" />
          </CallToAction>
        </div>
      </section>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  /* God Tier Hero Layout */
  .god-hero {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    background: rgba(197, 97, 246, 0.12);
    border: 1px solid rgba(197, 97, 246, 0.3);
    color: #c561f6;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    width: fit-content;
  }

  .status-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #00f2fe;
    box-shadow: 0 0 10px #00f2fe;
    animation: pulseGlow 2s infinite;
  }

  .hero-title {
    font-size: var(--text-3xl);
    line-height: 1.15;
    color: var(--gray-0);
    font-weight: 800;
  }

  .hero-tagline-box {
    padding: 1.25rem 1.5rem;
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.88);
    border-left: 4px solid var(--accent-regular) !important;
    border-top: 1px solid rgba(107, 33, 168, 0.15);
    border-right: 1px solid rgba(107, 33, 168, 0.15);
    border-bottom: 1px solid rgba(107, 33, 168, 0.15);
    max-width: 52ch;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
  }

  :root.theme-dark .hero-tagline-box {
    background: rgba(15, 23, 42, 0.6) !important;
    border-left: 4px solid #00f2fe !important;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .hero-tagline-box p {
    font-size: var(--text-lg);
    color: var(--gray-200);
    line-height: 1.6;
    margin: 0;
  }

  .highlight-text {
    color: var(--gray-0);
    font-weight: 700;
  }

  .gradient-accent-text {
    color: var(--accent-regular);
    font-weight: 700;
  }

  :root.theme-dark .gradient-accent-text {
    color: #00f2fe;
  }

  /* Cyber Roles Chips */
  .hero-cyber-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cyber-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.1rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--gray-0);
    background: rgba(107, 33, 168, 0.08) !important;
    border: 1px solid rgba(107, 33, 168, 0.25) !important;
    box-shadow: 0 4px 15px rgba(15, 23, 42, 0.05);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: default;
  }

  :root.theme-dark .cyber-chip {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06) !important;
    border: 1px solid rgba(197, 97, 246, 0.35) !important;
  }

  .cyber-chip:hover {
    background: rgba(197, 97, 246, 0.2) !important;
    border-color: var(--accent-regular) !important;
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 8px 25px rgba(118, 17, 166, 0.2);
  }

  .cyber-chip.active-chip {
