---
import { getCollection } from "astro:content";

// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from "../layouts/BaseLayout.astro";

// Component Imports
import CallToAction from "../components/CallToAction.astro";
import Grid from "../components/Grid.astro";
import Icon from "../components/Icon.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";

// Page section components
import ContactCTA from "../components/ContactCTA.astro";
import Skills from "../components/Skills.astro";
import InteractiveTerminal from "../components/InteractiveTerminal.astro";
import TechMarquee from "../components/TechMarquee.astro";

// Content Fetching: List four most recent work projects
const projects = (await getCollection("work"))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);
---

<BaseLayout>
  <div class="stack gap-15 lg:gap-30">
    <div class="wrapper stack gap-12 lg:gap-20">
      
      <!-- HERO GOD TIER SECTION -->
      <header class="god-hero">
        <div class="hero-content">
          <div class="status-badge">
            <span class="status-pulse"></span> DATA ENGINEER & DÉVELOPPEUR IA
          </div>

          <h1 class="hero-title">
            Hello, je m'appelle <br />
            <span class="gradient-text hero-title-shimmer">Mathieu Soussignan</span>
          </h1>

          <div class="hero-tagline-box glass-card">
            <p>
              Data Engineer & Développeur IA chez <span class="highlight-text">Keyrus</span> (Marseille). 
              Je conçois des <span class="gradient-accent-text">architectures Data robustes</span> et des applications Web & IA de bout en bout.
            </p>
          </div>

          <div class="hero-cyber-roles">
            <div class="cyber-chip glass-card">
              <span class="chip-icon">🤖</span>
              <span>Data Engineer & IA</span>
            </div>
            <div class="cyber-chip glass-card">
              <span class="chip-icon">⚡</span>
              <span>Développeur FullStack</span>
            </div>
            <div class="cyber-chip glass-card active-chip">
              <span class="chip-icon">💼</span>
              <span>CDI chez Keyrus</span>
            </div>
          </div>

          <div class="hero-actions">
            <a href="/work/" class="primary-hero-cta">
              <span>Explorer mes projets</span>
              <Icon icon="arrow-right" size="1.2em" />
            </a>
            <a href="mailto:contact@mathieu-soussignan.com" class="secondary-hero-cta glass-card">
              <span>Me contacter</span>
              <Icon icon="paper-plane-tilt" size="1.2em" />
            </a>
          </div>
        </div>

        <!-- GOD TIER PROFILE CARD WITH 3D HOLOGRAM TILT -->
        <div class="hero-profile-showcase">
          <div class="profile-card glass-card tilt-card-3d" id="hero-tilt-card">
            <div class="conic-neon-ring"></div>

            <div class="photo-wrapper layer-base-3d">
              <img
                alt="Mathieu Soussignan - Data Engineer & Développeur IA"
                src="/assets/profil-home.jpg"
                class="profile-img"
              />
              <div class="photo-glow"></div>
              <div class="shine-overlay"></div>
            </div>

            <div class="floating-tech tech-top-left glass-card layer-depth-3d">
              <span>🐍</span> Python & PyTorch
            </div>
            <div class="floating-tech tech-top-right glass-card layer-depth-3d">
              <span>🗄️</span> Data ETL & SQL
            </div>
            <div class="floating-tech tech-bottom-right glass-card layer-depth-3d">
              <span>⚡</span> React & FastAPI
            </div>

            <div class="profile-card-footer layer-base-3d">
              <span class="live-dot"></span>
              <span><strong>CDI chez Keyrus</strong> • Marseille / Aix</span>
            </div>
          </div>
        </div>
      </header>

      <script>
        // 3D Parallax Tilt & Light Shine Effect
        const tiltCard = document.getElementById('hero-tilt-card');
        if (tiltCard) {
          tiltCard.addEventListener('mousemove', (e) => {
            const rect = tiltCard.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            const rotateX = ((y - centerY) / centerY) * -16;
            const rotateY = ((x - centerX) / centerX) * 16;
            
            tiltCard.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.05, 1.05, 1.05)`;
            tiltCard.style.transition = 'none';

            const shine = tiltCard.querySelector('.shine-overlay') as HTMLElement;
            if (shine) {
              shine.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0) 65%)`;
            }
          });

          tiltCard.addEventListener('mouseleave', () => {
            tiltCard.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
            tiltCard.style.transition = 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
            const shine = tiltCard.querySelector('.shine-overlay') as HTMLElement;
            if (shine) {
              shine.style.background = 'none';
            }
          });
        }
      </script>

      <!-- TERMINAL SHOWCASE -->
      <section class="terminal-showcase-section">
        <div class="terminal-section-header">
          <h3>💻 Console & Terminal Interactif</h3>
          <p>Explorez mon profil et mes compétences en tapant des commandes ou en cliquant sur les raccourcis.</p>
        </div>
        <div class="terminal-wrapper">
          <InteractiveTerminal />
        </div>
      </section>

      <TechMarquee />

      <Skills />
    </div>

    <main class="wrapper stack gap-20 lg:gap-48">
      <section class="section with-background with-cta">
        <header class="section-header stack gap-2 lg:gap-4">
          <h3>Mes derniers projets</h3>
          <p>
            Découvrez mes derniers projets, réalisés pour des clients ou pour
            moi-même.
          </p>
        </header>

        <div class="gallery">
          <Grid variant="offset">
            {
              projects.map((project) => (
                <li>
                  <PortfolioPreview project={project} />
                </li>
              ))
            }
          </Grid>
        </div>

        <div class="cta">
          <CallToAction href="/work/">
            Tous mes projets
            <Icon icon="arrow-right" size="1.2em" />
          </CallToAction>
        </div>
      </section>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  /* God Tier Hero Layout */
  .god-hero {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    background: rgba(197, 97, 246, 0.12);
    border: 1px solid rgba(197, 97, 246, 0.3);
    color: #c561f6;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    width: fit-content;
  }

  .status-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #00f2fe;
    box-shadow: 0 0 10px #00f2fe;
    animation: pulseGlow 2s infinite;
  }

  .hero-title {
    font-size: var(--text-3xl);
    line-height: 1.15;
    color: var(--gray-0);
    font-weight: 800;
  }

  .hero-tagline-box {
    padding: 1.25rem 1.5rem;
    border-radius: 1.25rem;
    background: rgba(15, 23, 42, 0.6) !important;
    border-left: 4px solid #00f2fe !important;
    max-width: 52ch;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .hero-tagline-box p {
    font-size: var(--text-lg);
    color: var(--gray-200);
    line-height: 1.6;
    margin: 0;
  }

  .highlight-text {
    color: #ffffff;
    font-weight: 700;
  }

  .gradient-accent-text {
    color: #00f2fe;
    font-weight: 600;
  }

  /* Cyber Roles Chips */
  .hero-cyber-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cyber-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.1rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06) !important;
    border: 1px solid rgba(197, 97, 246, 0.35) !important;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: default;
  }

  .cyber-chip:hover {
    background: rgba(197, 97, 246, 0.2) !important;
    border-color: #00f2fe !important;
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 8px 25px rgba(118, 17, 166, 0.4);
  }

  .cyber-chip.active-chip {
    border-color: rgba(39, 201, 63, 0.6) !important;
    background: rgba(39, 201, 63, 0.12) !important;
    color: #ffffff;
  }

  /* Hero Actions */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
    margin-top: 0.75rem;
  }

  .primary-hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 2rem;
    border-radius: 9999px;
    background: linear-gradient(135deg, #7611a6 0%, #c561f6 50%, #00f2fe 100%);
    color: #ffffff;
    font-weight: 700;
    font-size: var(--text-md);
    text-decoration: none;
    box-shadow: 0 10px 30px rgba(118, 17, 166, 0.6);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .primary-hero-cta:hover {
    transform: translateY(-4px) scale(1.03);
    box-shadow: 0 15px 40px rgba(0, 242, 254, 0.5);
    color: #ffffff;
  }

  .secondary-hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1.8rem;
    border-radius: 9999px;
    color: #ffffff;
    font-weight: 600;
    font-size: var(--text-md);
    text-decoration: none;
    background: rgba(15, 23, 42, 0.7) !important;
    border: 1px solid rgba(255, 255, 255, 0.18) !important;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .secondary-hero-cta:hover {
    background: rgba(197, 97, 246, 0.25) !important;
    border-color: #00f2fe !important;
    transform: translateY(-4px);
    color: #ffffff;
  }

  /* Liquid Shimmer Text Animation */
  .hero-title-shimmer {
    background: linear-gradient(90deg, #c561f6 0%, #00f2fe 30%, #ff7000 70%, #c561f6 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: liquidShimmer 4s linear infinite;
    display: inline-block;
  }

  @keyframes liquidShimmer {
    0% { background-position: 0% center; }
    100% { background-position: 200% center; }
  }

  /* Profile Card Showcase 3D Hologram */
  .hero-profile-showcase {
    position: relative;
    width: 100%;
    max-width: 420px;
    display: flex;
    justify-content: center;
    perspective: 1000px;
  }

  .profile-card {
    position: relative;
    width: 100%;
    border-radius: 2rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: rgba(15, 23, 42, 0.85) !important;
    border: 1px solid rgba(197, 97, 246, 0.4) !important;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6), 0 0 50px rgba(118, 17, 166, 0.3);
    transform-style: preserve-3d;
    will-change: transform;
    overflow: visible !important;
  }

  .conic-neon-ring {
    position: absolute;
    inset: -3px;
    border-radius: 2.1rem;
    background: conic-gradient(from 0deg, #c561f6, #00f2fe, #ff7000, #7611a6, #c561f6);
    z-index: -1;
    opacity: 0.85;
    filter: blur(8px);
    animation: conicRotate 6s linear infinite;
  }

  @keyframes conicRotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .photo-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 1.5rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transform-style: preserve-3d;
  }

  .shine-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    transition: background 0.1s ease;
  }

  .layer-depth-3d {
    transform: translateZ(45px);
  }

  .layer-base-3d {
    transform: translateZ(15px);
  }

  .profile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.5s ease;
  }

  .profile-card:hover .profile-img {
    transform: scale(1.04);
  }

  .photo-glow {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, rgba(9, 11, 17, 0.85) 100%);
    pointer-events: none;
  }

  .floating-tech {
    position: absolute;
    padding: 0.4rem 0.88rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    color: #ffffff;
    background: rgba(15, 23, 42, 0.92) !important;
    border: 1px solid rgba(197, 97, 246, 0.5) !important;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    z-index: 5;
    pointer-events: none;
    backdrop-filter: blur(12px);
  }

  .tech-top-left {
    top: -14px;
    left: -14px;
  }

  .tech-top-right {
    top: -14px;
    right: -14px;
  }

  .tech-bottom-right {
    bottom: 50px;
    right: -14px;
  }

  .profile-card-footer {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: var(--gray-200);
    padding: 0.5rem 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 0.75rem;
  }

  .live-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #27c93f;
    box-shadow: 0 0 10px #27c93f;
    animation: pulseGlow 2s infinite;
  }

  /* Terminal Section */
  .terminal-showcase-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
    width: 100%;
    margin-top: 1rem;
  }

  .terminal-section-header {
    text-align: center;
    max-width: 50ch;
  }

  .terminal-section-header h3 {
    font-size: var(--text-2xl);
    color: var(--gray-0);
  }

  .terminal-section-header p {
    color: var(--gray-400);
    font-size: var(--text-sm);
    margin-top: 0.4rem;
  }

  .terminal-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  @media (min-width: 50em) {
    .god-hero {
      display: grid;
      grid-template-columns: 6fr 5fr;
      gap: 4rem;
      align-items: center;
    }

    .hero-title {
      font-size: var(--text-5xl);
    }
  }

  /* ====================================================== */

  .section {
    display: grid;
    gap: 2rem;
  }

  .with-background {
    position: relative;
  }

  .with-background::before {
    --hero-bg: var(--bg-image-subtle-2);

    content: "";
    position: absolute;
    pointer-events: none;
    left: 50%;
    width: 100vw;
    aspect-ratio: calc(2.25 / var(--bg-scale));
    top: 0;
    transform: translateY(-75%) translateX(-50%);
    background:
      url("/assets/backgrounds/noise.png") top center/220px repeat,
      var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
      var(--gray-999);
    background-blend-mode: overlay, normal, normal, normal;
    mix-blend-mode: var(--bg-blend-mode);
    z-index: -1;
  }

  .with-background.bg-variant::before {
    --hero-bg: var(--bg-image-subtle-1);
  }

  .section-header {
    justify-self: center;
    text-align: center;
    max-width: 50ch;
    font-size: var(--text-md);
    color: var(--gray-300);
  }

  .section-header h3 {
    font-size: var(--text-2xl);
  }

  @media (min-width: 50em) {
    .section {
      grid-template-columns: repeat(4, 1fr);
      grid-template-areas: "header header header header" "gallery gallery gallery gallery";
      gap: 5rem;
    }

    .section.with-cta {
      grid-template-areas: "header header header cta" "gallery gallery gallery gallery";
    }

    .section-header {
      grid-area: header;
      font-size: var(--text-lg);
    }

    .section-header h3 {
      font-size: var(--text-4xl);
    }

    .with-cta .section-header {
      justify-self: flex-start;
      text-align: left;
    }

    .gallery {
      grid-area: gallery;
    }

    .cta {
      grid-area: cta;
    }
  }

  /* ====================================================== */

  .mention-card {
    display: flex;
    height: 7rem;
    justify-content: center;
    align-items: center;
    text-align: center;
    border: 1px solid var(--gray-800);
    border-radius: 1.5rem;
    color: var(--gray-300);
    background: var(--gradient-subtle);
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 50em) {
    .mention-card {
      border-radius: 1.5rem;
      height: 9.5rem;
    }
  }
</style>
