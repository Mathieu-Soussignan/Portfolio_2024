---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="L'ŒUF D'OR DE HALLIDAY | Mathieu Soussignan" description="Vous avez découvert l'Easter Egg Ultime.">
  <!-- Cinématique Hollywoodienne RPO - Overlay d'intro -->
  <div class="rp-overlay" id="rpOverlay">
    <div class="rp-letterbox top"></div>
    <div class="rp-letterbox bottom"></div>
    <canvas id="rpCanvas"></canvas>
    
    <!-- Optical Lens Flare Cursor Light -->
    <div class="rp-lens-flare" id="rpLensFlare"></div>

    <div class="rp-content" id="rpContent">
      <div class="rp-act-badge" id="rpActBadge">AN OASIS HERITAGE PRODUCTION</div>
      
      <!-- Act 2: Key Fusion Container -->
      <div class="rp-keys-fusion hidden" id="rpKeysFusion">
        <div class="rp-key-orb k-copper" id="rpKCopper">🥉</div>
        <div class="rp-key-orb k-jade" id="rpKJade">🥈</div>
        <div class="rp-key-orb k-crystal" id="rpKCrystal">🥇</div>
        <div class="rp-fusion-core" id="rpFusionCore"></div>
      </div>

      <div class="rp-subtitle" id="rpSubtitle"></div>
      <div class="rp-quote" id="rpQuote"></div>
      <div class="rp-quote-author" id="rpQuoteAuthor"></div>
    </div>

    <div class="rp-skip-container" id="rpSkipContainer">
      <button class="rp-skip-btn" id="rpSkipBtn">SKIP INTRO >></button>
      <div class="rp-progress-bar">
        <div class="rp-progress-fill" id="rpProgressFill"></div>
      </div>
    </div>
  </div>

  <div class="sanctuary-container" id="sanctuaryContainer" style="display: none;">
    <div class="stars-bg"></div>
    
    <header class="sanctuary-header">
      <a href="/" class="back-link">← RETOURNER AU MONDE RÉEL</a>
      <h1 class="glowing-title">🥚 L'ŒUF D'OR DE HALLIDAY</h1>
      <p class="subtitle">Félicitations, Gunter ! Tu as réuni les 3 Clés de l'OASIS et découvert l'Easter Egg Ultime.</p>
      <div class="status-badge">🏆 RANG : HÉRITIER UNIQUE DE L'OASIS | COMPLÉTION : 100%</div>
    </header>

    <main>
      <div class="egg-container" id="eggContainer">
        <canvas id="eggCanvas" width="600" height="400"></canvas>
        <div class="click-hint">CLIQUEZ SUR L'ŒUF</div>
      </div>

      <div class="revelation-flash" id="revelationFlash"></div>

      <div class="certificate-container hidden" id="certificateContainer">
        <div class="hologram-effect"></div>
        <div class="certificate-content">
          <h2>HÉREDITÉ DE L'OASIS — CERTIFICAT OFFICIEL</h2>
          <p class="quote">"Merci d'avoir joué à mon jeu. Tu as prouvé ta passion, ta curiosité et ton talent de dev."</p>
          <p class="signature">— James Halliday & Mathieu Soussignan</p>
          
          <div class="vip-actions">
            <a href="mailto:contact@mathieu-soussignan.com?subject=VIP%20OASIS%20Coffee%20Chat" class="vip-btn gold">
              <span class="icon">☕</span> Réserver un café VIP avec Mathieu
            </a>
            <button class="vip-btn cyan" onclick="alert('Badge Légendaire S++ débloqué ! (Imaginaire)')">
              <span class="icon">📜</span> Télécharger le Badge Légendaire S++
            </button>
            <a href="/easter-egg/arcade/" class="vip-btn purple">
              <span class="icon">🕹️</span> Rejouer aux Easter Eggs
            </a>
          </div>
        </div>
      </div>

      <section class="atari-tribute">
        <div class="terminal-box">
          <h3>TRIBUTE : ADVENTURE (1979)</h3>
          <p>
            En 1979, Warren Robinett a créé le premier "Easter Egg" dans le jeu vidéo Adventure sur Atari 2600.
            Mécontent que les créateurs de jeux ne soient pas crédités, il a caché une salle secrète contenant
            le texte "Created by Warren Robinett". C'est cette rébellion créative qui a inspiré l'OASIS et 
            cette quête.
          </p>
          <div class="atari-pixel"></div>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  :root {
    --gold: #ffd700;
    --cyan: #00f2fe;
    --purple: #c561f6;
    --dark-bg: #0a0e17;
  }

  /* ===== CINÉMATIQUE HOLLYWOODIENNE RPO ===== */
  .rp-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: #020306;
    z-index: 99999;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transition: opacity 1.5s ease-in-out;
    overflow: hidden;
  }

  .rp-overlay.fade-out {
    opacity: 0;
    pointer-events: none;
  }

  /* Hollywood Anamorphic Letterbox Bars */
  .rp-letterbox {
    position: absolute;
    left: 0;
    width: 100%;
    height: 7vh;
    background: #000000;
    z-index: 10;
    box-shadow: 0 0 20px rgba(0,0,0,0.9);
  }
  .rp-letterbox.top { top: 0; border-bottom: 1px solid rgba(255,215,0,0.15); }
  .rp-letterbox.bottom { bottom: 0; border-top: 1px solid rgba(255,215,0,0.15); }

  /* Optical Lens Flare Glow */
  .rp-lens-flare {
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0,242,254,0.15) 0%, rgba(255,215,0,0.08) 40%, transparent 70%);
    pointer-events: none;
    z-index: 1;
    transform: translate(-50%, -50%);
    transition: left 0.1s ease-out, top 0.1s ease-out;
    mix-blend-mode: screen;
  }

  #rpCanvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .rp-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 900px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .rp-act-badge {
    font-family: 'Fira Code', monospace;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.3em;
    color: #ffd700;
    background: rgba(255, 215, 0, 0.1);
    padding: 0.4rem 1.2rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 215, 0, 0.4);
    box-shadow: 0 0 20px rgba(255, 215, 0, 0.3);
    margin-bottom: 2rem;
    text-shadow: 0 0 10px #ffd700;
    animation: actBadgeGlow 2s ease-in-out infinite alternate;
  }
  @keyframes actBadgeGlow {
    from { box-shadow: 0 0 15px rgba(255, 215, 0, 0.2); }
    to { box-shadow: 0 0 35px rgba(255, 215, 0, 0.6), 0 0 15px #00f2fe; }
  }

  /* Act 2: Key Fusion Graphic */
  .rp-keys-fusion {
    position: relative;
    width: 260px;
    height: 180px;
    margin: 1rem 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .rp-keys-fusion.hidden { display: none; }

  .rp-key-orb {
    position: absolute;
    font-size: 3rem;
    filter: drop-shadow(0 0 20px #ffd700);
    transition: all 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .rp-key-orb.k-copper { top: 0; left: 20px; animation: orbFloat1 2s ease-in-out infinite alternate; }
  .rp-key-orb.k-jade { top: 0; right: 20px; animation: orbFloat2 2.2s ease-in-out infinite alternate; }
  .rp-key-orb.k-crystal { bottom: 0; animation: orbFloat3 1.8s ease-in-out infinite alternate; }

  @keyframes orbFloat1 { from { transform: translateY(0); } to { transform: translateY(-10px); } }
  @keyframes orbFloat2 { from { transform: translateY(0); } to { transform: translateY(-12px); } }
  @keyframes orbFloat3 { from { transform: translateY(0); } to { transform: translateY(8px); } }

  .rp-key-orb.fused {
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) scale(1.8) !important;
    filter: drop-shadow(0 0 60px #ffd700) drop-shadow(0 0 100px #00f2fe);
  }

  .rp-fusion-core {
    position: absolute;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffd700 0%, #00f2fe 50%, transparent 80%);
    opacity: 0;
    transform: scale(0.2);
    transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .rp-fusion-core.active {
    opacity: 1;
    transform: scale(2.5);
    box-shadow: 0 0 100px #ffd700, 0 0 150px #00f2fe;
  }

  .rp-subtitle {
    font-family: 'Fira Code', monospace;
    font-size: 0.95rem;
    color: var(--gold);
    text-shadow: 0 0 10px var(--gold), 0 0 20px rgba(255, 215, 0, 0.5);
    margin-bottom: 1.5rem;
    min-height: 1.5rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .rp-subtitle.visible {
    opacity: 1;
  }

  .rp-quote {
    font-family: 'Georgia', 'Times New Roman', serif;
    font-size: 1.85rem;
    color: #fff;
    text-shadow: 0 0 20px rgba(255, 255, 255, 0.4);
    line-height: 1.6;
    min-height: 3.5rem;
    margin-bottom: 1.5rem;
    font-style: italic;
    opacity: 0;
    transition: opacity 1s ease;
  }

  .rp-quote.visible {
    opacity: 1;
  }

  .rp-quote .char {
    opacity: 0;
    transition: opacity 0.05s ease;
  }

  .rp-quote .char.revealed {
    opacity: 1;
  }

  .rp-quote-author {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    color: var(--cyan);
    text-shadow: 0 0 10px var(--cyan);
    min-height: 1.5rem;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .rp-quote-author.visible {
    opacity: 1;
  }

  .rp-skip-container {
    position: absolute;
    bottom: 40px;
    width: 100%;
    max-width: 600px;
    padding: 0 2rem;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .rp-skip-btn {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: rgba(255, 255, 255, 0.5);
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.8rem;
    padding: 0.4rem 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    letter-spacing: 2px;
  }

  .rp-skip-btn:hover {
    border-color: rgba(255, 255, 255, 0.8);
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  .rp-progress-bar {
    width: 100%;
    height: 2px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    overflow: hidden;
  }

  .rp-progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--gold), #ff8c00);
    box-shadow: 0 0 10px var(--gold);
    transition: width 0.3s linear;
    border-radius: 2px;
  }

  /* ===== RESTE DU STYLE EXISTANT ===== */
  .sanctuary-container {
    min-height: 100vh;
    background-color: var(--dark-bg);
    color: white;
    font-family: 'Courier New', Courier, monospace;
    position: relative;
    overflow-x: hidden;
    padding: 2rem;
  }

  .stars-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      radial-gradient(2px 2px at 20px 30px, #eee, rgba(0,0,0,0)),
      radial-gradient(2px 2px at 40px 70px, #fff, rgba(0,0,0,0)),
      radial-gradient(2px 2px at 50px 160px, #ddd, rgba(0,0,0,0)),
      radial-gradient(2px 2px at 90px 40px, #fff, rgba(0,0,0,0)),
      radial-gradient(2px 2px at 130px 80px, #fff, rgba(0,0,0,0)),
      radial-gradient(2px 2px at 160px 120px, #ddd, rgba(0,0,0,0));
    background-repeat: repeat;
    background-size: 200px 200px;
    opacity: 0.3;
    z-index: 0;
    pointer-events: none;
    animation: drift 100s linear infinite;
  }

  @keyframes drift {
    from { transform: translateY(0); }
    to { transform: translateY(-200px); }
  }

  .sanctuary-header, main {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .back-link {
    display: inline-block;
    color: var(--cyan);
    text-decoration: none;
    margin-bottom: 2rem;
    text-shadow: 0 0 10px var(--cyan);
    transition: all 0.3s ease;
  }

  .back-link:hover {
    color: #fff;
    text-shadow: 0 0 20px var(--cyan), 0 0 30px var(--cyan);
  }

  .glowing-title {
    font-size: 3rem;
    color: var(--gold);
    text-shadow: 0 0 10px var(--gold), 0 0 20px var(--gold), 0 0 40px #ff8c00;
    margin-bottom: 1rem;
    font-weight: bold;
    letter-spacing: 2px;
  }

  .subtitle {
    font-size: 1.2rem;
    color: #aaa;
    margin-bottom: 2rem;
  }

  .status-badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(197, 97, 246, 0.2);
    border: 1px solid var(--purple);
    border-radius: 4px;
    color: var(--purple);
    font-weight: bold;
    box-shadow: 0 0 15px rgba(197, 97, 246, 0.5);
    margin-bottom: 3rem;
  }

  .egg-container {
    position: relative;
    width: 100%;
    max-width: 600px;
    margin: 0 auto 3rem auto;
    cursor: pointer;
  }

  canvas {
    width: 100%;
    height: auto;
    border-radius: 20px;
    box-shadow: 0 0 50px rgba(255, 215, 0, 0.1);
    transition: box-shadow 0.3s ease;
  }

  .egg-container:hover canvas {
    box-shadow: 0 0 80px rgba(255, 215, 0, 0.3);
  }

  .click-hint {
    position: absolute;
    bottom: -30px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--gold);
    font-size: 0.9rem;
    letter-spacing: 3px;
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  .revelation-flash {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: white;
    z-index: 100;
    opacity: 0;
    pointer-events: none;
    transition: opacity 1s cubic-bezier(0.1, 0.9, 0.2, 1);
  }

  .revelation-flash.active {
    opacity: 1;
    pointer-events: all;
  }

  .certificate-container {
    position: relative;
    background: rgba(255, 215, 0, 0.05);
    border: 2px solid var(--gold);
    padding: 3rem 2rem;
    border-radius: 10px;
    margin-bottom: 4rem;
    box-shadow: 0 0 30px rgba(255, 215, 0, 0.2), inset 0 0 20px rgba(255, 215, 0, 0.1);
    overflow: hidden;
    backdrop-filter: blur(10px);
  }

  .certificate-container.hidden {
    display: none;
  }

  .hologram-effect {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      180deg,
      rgba(0, 242, 254, 0) 0%,
      rgba(0, 242, 254, 0.1) 50%,
      rgba(0, 242, 254, 0) 100%
    );
    background-size: 100% 200%;
    animation: scanline 4s linear infinite;
    pointer-events: none;
  }

  @keyframes scanline {
    0% { background-position: 0 -100%; }
    100% { background-position: 0 200%; }
  }

  .certificate-content h2 {
    color: var(--gold);
    font-size: 1.8rem;
    margin-bottom: 2rem;
    text-shadow: 0 0 10px var(--gold);
  }

  .quote {
    font-size: 1.4rem;
    font-style: italic;
    color: #fff;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .signature {
    text-align: right;
    color: var(--cyan);
    font-size: 1.1rem;
    margin-bottom: 3rem;
  }

  .vip-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }

  @media (min-width: 600px) {
    .vip-actions {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }
  }

  .vip-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.5rem;
    border-radius: 5px;
    font-weight: bold;
    text-decoration: none;
    font-family: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
    border: none;
    background: transparent;
  }

  .vip-btn.gold {
    border: 1px solid var(--gold);
    color: var(--gold);
  }
  .vip-btn.gold:hover {
    background: var(--gold);
    color: var(--dark-bg);
    box-shadow: 0 0 15px var(--gold);
  }

  .vip-btn.cyan {
    border: 1px solid var(--cyan);
    color: var(--cyan);
  }
  .vip-btn.cyan:hover {
    background: var(--cyan);
    color: var(--dark-bg);
    box-shadow: 0 0 15px var(--cyan);
  }

  .vip-btn.purple {
    border: 1px solid var(--purple);
    color: var(--purple);
  }
  .vip-btn.purple:hover {
    background: var(--purple);
    color: white;
    box-shadow: 0 0 15px var(--purple);
  }

  .atari-tribute {
    margin-top: 4rem;
    text-align: left;
  }

  .terminal-box {
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid #333;
    border-left: 4px solid var(--purple);
    padding: 1.5rem;
    border-radius: 4px;
  }

  .terminal-box h3 {
    color: var(--purple);
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }

  .terminal-box p {
    color: #ccc;
    line-height: 1.6;
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .atari-pixel {
    width: 20px;
    height: 20px;
    background: #555;
    animation: blink 2s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { background: #555; }
    50% { background: var(--purple); box-shadow: 0 0 10px var(--purple); }
  }

  @media (max-width: 768px) {
    .rp-quote {
      font-size: 1.2rem;
      padding: 0 1rem;
    }
    .rp-subtitle {
      font-size: 0.7rem;
    }
    .glowing-title {
      font-size: 2rem;
    }
  }
</style>

<script>
  // ============================================================
  // 🎬 HOLLYWOOD BLOCKBUSTER CINEMATIC — READY PLAYER ONE
  // ============================================================
  const rpOverlay = document.getElementById('rpOverlay');
  const rpCanvas = document.getElementById('rpCanvas') as HTMLCanvasElement;
  const rpCtx = rpCanvas?.getContext('2d');
  const rpSubtitle = document.getElementById('rpSubtitle');
  const rpQuote = document.getElementById('rpQuote');
  const rpQuoteAuthor = document.getElementById('rpQuoteAuthor');
  const rpSkipBtn = document.getElementById('rpSkipBtn');
  const rpProgressFill = document.getElementById('rpProgressFill');
  const sanctuaryContainer = document.getElementById('sanctuaryContainer');
  const rpActBadge = document.getElementById('rpActBadge');
  const rpKeysFusion = document.getElementById('rpKeysFusion');
  const rpKCopper = document.getElementById('rpKCopper');
  const rpKJade = document.getElementById('rpKJade');
  const rpKCrystal = document.getElementById('rpKCrystal');
  const rpFusionCore = document.getElementById('rpFusionCore');
  const rpLensFlare = document.getElementById('rpLensFlare');

  if (!rpOverlay || !rpCanvas || !rpCtx || !rpSubtitle || !rpQuote || !rpQuoteAuthor || !rpSkipBtn || !rpProgressFill || !sanctuaryContainer) {
    if (sanctuaryContainer) sanctuaryContainer.style.display = 'block';
    if (rpOverlay) rpOverlay.style.display = 'none';
  } else {
    // ---- Resize canvas ----
    function resizeCanvas() {
      rpCanvas!.width = window.innerWidth;
      rpCanvas!.height = window.innerHeight;
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    // ---- Interactive Optical Lens Flare ----
    window.addEventListener('mousemove', (e) => {
      if (rpLensFlare) {
        rpLensFlare.style.left = `${e.clientX}px`;
        rpLensFlare.style.top = `${e.clientY}px`;
      }
    });

    // ---- HOLLYWOOD WEB AUDIO SOUND DESIGN ----
    function playSubBassBoom() {
      try {
        const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.type = 'sine';
        o.frequency.setValueAtTime(80, ctx.currentTime);
        o.frequency.exponentialRampToValueAtTime(30, ctx.currentTime + 1.5);
        g.gain.setValueAtTime(0.4, ctx.currentTime);
        g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 1.8);
        o.connect(g); g.connect(ctx.destination);
        o.start(); o.stop(ctx.currentTime + 1.8);
      } catch(_e) {}
    }

    function playKeyLockChime(freq: number) {
      try {
        const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.type = 'triangle';
        o.frequency.setValueAtTime(freq, ctx.currentTime);
        o.frequency.exponentialRampToValueAtTime(freq * 1.5, ctx.currentTime + 0.3);
        g.gain.setValueAtTime(0.2, ctx.currentTime);
        g.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.6);
        o.connect(g); g.connect(ctx.destination);
        o.start(); o.stop(ctx.currentTime + 0.6);
      } catch(_e) {}
    }

    function playFinaleCrescendo() {
      try {
        const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.type = 'sawtooth';
        o.frequency.setValueAtTime(100, ctx.currentTime);
        o.frequency.exponentialRampToValueAtTime(1600, ctx.currentTime + 1.5);
        g.gain.setValueAtTime(0.1, ctx.currentTime);
        g.gain.linearRampToValueAtTime(0.35, ctx.currentTime + 1.2);
        g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 1.6);
        o.connect(g); g.connect(ctx.destination);
        o.start(); o.stop(ctx.currentTime + 1.6);
      } catch(_e) {}
    }

    // ---- State ----
    let cinematicActive = true;
    let startTime = Date.now();
    const CINEMATIC_DURATION = 15000; // 15 seconds total

    // ---- Background Particles (Space Dust + Portal Glyphs) ----
    interface RpParticle {
      x: number; y: number; speed: number; char: string; size: number; opacity: number; isGlyph: boolean; glow: number;
    }
    const particles: RpParticle[] = [];
    const glyphChars = '🔑🗝️💎⭐🏆⚡✨';
    const matrixChars = 'OASIS101010101HALLIDAY010101';

    function initParticles() {
      particles.length = 0;
      for (let i = 0; i < 100; i++) {
        const isGlyph = i < 30;
        particles.push({
          x: Math.random() * rpCanvas!.width,
          y: Math.random() * rpCanvas!.height,
          speed: 20 + Math.random() * 50,
          char: isGlyph ? glyphChars[Math.floor(Math.random() * glyphChars.length)] : matrixChars[Math.floor(Math.random() * matrixChars.length)],
          size: isGlyph ? (12 + Math.random() * 18) : (8 + Math.random() * 10),
          opacity: 0.15 + Math.random() * 0.5,
          isGlyph,
          glow: 5 + Math.random() * 20
        });
      }
    }

    function drawParticles(time: number) {
      if (!rpCtx) return;
      rpCtx.clearRect(0, 0, rpCanvas!.width, rpCanvas!.height);

      const grad = rpCtx.createRadialGradient(
        rpCanvas!.width / 2, rpCanvas!.height / 2, 0,
        rpCanvas!.width / 2, rpCanvas!.height / 2, rpCanvas!.width * 0.8
      );
      grad.addColorStop(0, '#0a0d18');
      grad.addColorStop(0.5, '#04060b');
      grad.addColorStop(1, '#000000');
      rpCtx.fillStyle = grad;
      rpCtx.fillRect(0, 0, rpCanvas!.width, rpCanvas!.height);

      particles.forEach(p => {
        p.y += p.speed * (1 / 60);
        if (p.y > rpCanvas!.height) {
          p.y = -20;
          p.x = Math.random() * rpCanvas!.width;
        }
        p.x += Math.sin(time * 0.001 + p.y * 0.01) * 0.5;

        rpCtx.font = `${p.size}px monospace`;
        rpCtx.shadowBlur = p.glow;
        rpCtx.shadowColor = p.isGlyph ? '#ffd700' : '#00f2fe';
        rpCtx.fillStyle = p.isGlyph ? `rgba(255, 215, 0, ${p.opacity})` : `rgba(0, 242, 254, ${p.opacity * 0.4})`;
        rpCtx.fillText(p.char, p.x, p.y);
        rpCtx.shadowBlur = 0;
      });
    }

    initParticles();

    // ---- Typewriter effect for quotes ----
    function typeQuote(text: string, element: HTMLElement, speed: number = 25): Promise<void> {
      return new Promise((resolve) => {
        element.innerHTML = '';
        element.classList.add('visible');
        let i = 0;
        function type() {
          if (i < text.length) {
            const span = document.createElement('span');
            span.className = 'char';
            span.textContent = text.charAt(i);
            element.appendChild(span);
            requestAnimationFrame(() => span.classList.add('revealed'));
            i++;
            setTimeout(type, speed);
          } else {
            resolve();
          }
        }
        type();
      });
    }

    function clearQuote() {
      rpQuote!.innerHTML = '';
      rpQuote!.classList.remove('visible');
      rpQuoteAuthor!.classList.remove('visible');
      rpQuoteAuthor!.textContent = '';
    }

    function showSubtitle(text: string) {
      rpSubtitle!.textContent = text;
      rpSubtitle!.classList.add('visible');
    }

    function hideSubtitle() {
      rpSubtitle!.classList.remove('visible');
    }

    // ---- HOLLYWOOD MULTI-ACT SEQUENCE ----
    let animFrameId: number;

    async function runCinematicSequence() {
      playSubBassBoom();

      // ACT 1: LOGO & SYSTEM INITIALIZATION
      if (rpActBadge) rpActBadge.textContent = 'AN OASIS HERITAGE PRODUCTION';
      showSubtitle('/// INITIALISATION DU PROTOCOLE HALLIDAY //');
      await new Promise(r => setTimeout(r, 600));
      if (!cinematicActive) return;

      await typeQuote('"La réalité est un triste désert. Mais ici, dans l\'OASIS, tu peux réaliser l\'impossible."', rpQuote!, 22);
      if (!cinematicActive) return;

      rpQuoteAuthor!.textContent = '— James Halliday, Ready Player One';
      rpQuoteAuthor!.classList.add('visible');
      await new Promise(r => setTimeout(r, 2200));
      if (!cinematicActive) return;

      // ACT 2: FUSION DES 3 CLÉS DE HALLIDAY
      clearQuote();
      hideSubtitle();
      if (rpActBadge) rpActBadge.textContent = 'ACTE II — L\'ASSEMBLAGE DES 3 CLÉS';
      showSubtitle('/// FUSION DES CLÉS DE CUIVRE, JADE & CRISTAL //');
      
      if (rpKeysFusion) rpKeysFusion.classList.remove('hidden');
      await new Promise(r => setTimeout(r, 400));
      playKeyLockChime(440); // Copper key lock
      await new Promise(r => setTimeout(r, 500));
      playKeyLockChime(554); // Jade key lock
      await new Promise(r => setTimeout(r, 500));
      playKeyLockChime(659); // Crystal key lock

      await new Promise(r => setTimeout(r, 600));
      if (!cinematicActive) return;

      // Keys converge into central fusion core
      if (rpKCopper) rpKCopper.classList.add('fused');
      if (rpKJade) rpKJade.classList.add('fused');
      if (rpKCrystal) rpKCrystal.classList.add('fused');
      if (rpFusionCore) rpFusionCore.classList.add('active');
      playSubBassBoom();

      await new Promise(r => setTimeout(r, 2200));
      if (!cinematicActive) return;

      // Hide Fusion graphic for Act 3
      if (rpKeysFusion) rpKeysFusion.classList.add('hidden');

      // ACT 3: THE HALLIDAY PROPHESY & REWARD
      if (rpActBadge) rpActBadge.textContent = 'ACTE III — LE SANCTUAIRE ULTIME';
      showSubtitle('/// HÉRITAGE EXCLUSIF — LE TRÉSOR EST À TOI //');
      
      await typeQuote('"Merci d\'avoir joué à mon jeu. Tu as prouvé ta passion, ta curiosité et ton génie de dev."', rpQuote!, 22);
      if (!cinematicActive) return;

      rpQuoteAuthor!.textContent = '— James Halliday, L\'Œuf d\'Or';
      rpQuoteAuthor!.classList.add('visible');

      await new Promise(r => setTimeout(r, 2500));
      if (!cinematicActive) return;

      // ACT 4: FINALE EXPLOSION REVEAL
      playFinaleCrescendo();
      transitionToSanctuary();
    }

    function transitionToSanctuary() {
      cinematicActive = false;
      rpOverlay!.classList.add('fade-out');
      sanctuaryContainer!.style.display = 'block';
      requestAnimationFrame(() => window.scrollTo(0, 0));
      setTimeout(() => {
        rpOverlay!.style.display = 'none';
        if (animFrameId) cancelAnimationFrame(animFrameId);
      }, 1400);
    }

    function updateProgress() {
      if (!cinematicActive) return;
      const elapsed = Date.now() - startTime;
      const progress = Math.min(elapsed / CINEMATIC_DURATION, 1);
      rpProgressFill!.style.width = `${progress * 100}%`;
      if (progress < 1) requestAnimationFrame(updateProgress);
    }

    rpSkipBtn!.addEventListener('click', () => {
      if (!cinematicActive) return;
      cinematicActive = false;
      if (animFrameId) cancelAnimationFrame(animFrameId);
      transitionToSanctuary();
    });

    function renderLoop(time: number) {
      if (cinematicActive) {
        drawParticles(time);
        animFrameId = requestAnimationFrame(renderLoop);
      }
    }

    function startCinematic() {
      startTime = Date.now();
      renderLoop(0);
      updateProgress();
      runCinematicSequence();
    }

    setTimeout(startCinematic, 200);
  }

  // ============================================================
  // CODE EXISTANT : ŒUF CANVAS + FANFARE
  // ============================================================
  const eggCanvas = document.getElementById('eggCanvas') as HTMLCanvasElement;
  const eggCtx = eggCanvas.getContext('2d');
  const eggContainer = document.getElementById('eggContainer');
  const flash = document.getElementById('revelationFlash');
  const certificate = document.getElementById('certificateContainer');

  if (eggCanvas && eggCtx && eggContainer) {
    let width = eggCanvas.width;
    let height = eggCanvas.height;
    let time = 0;
    let isHovered = false;
    let isOpened = false;
    let openTime = 0;

    let audioCtx: AudioContext | null = null;
    function playFanfare() {
      try {
        audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        
        osc.type = 'square';
        osc.frequency.setValueAtTime(440, audioCtx.currentTime); // A4
        osc.frequency.setValueAtTime(554.37, audioCtx.currentTime + 0.2); // C#5
        osc.frequency.setValueAtTime(659.25, audioCtx.currentTime + 0.4); // E5
        osc.frequency.setValueAtTime(880, audioCtx.currentTime + 0.6); // A5
        
        gain.gain.setValueAtTime(0, audioCtx.currentTime);
        gain.gain.linearRampToValueAtTime(0.1, audioCtx.currentTime + 0.1);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 2);
        
        osc.start();
        osc.stop(audioCtx.currentTime + 2);
      } catch (e) {
        console.log('Audio disabled or not supported.');
      }
    }

    class Particle {
      x: number;
      y: number;
      radius: number;
      angle: number;
      speed: number;
      orbitY: number;

      constructor() {
        this.angle = Math.random() * Math.PI * 2;
        this.radius = 80 + Math.random() * 40;
        this.speed = 0.02 + Math.random() * 0.02;
        this.orbitY = -50 + Math.random() * 100;
        this.x = 0;
        this.y = 0;
      }

      update(hover: boolean) {
        this.angle += hover ? this.speed * 3 : this.speed;
        this.x = width / 2 + Math.cos(this.angle) * this.radius;
        this.y = height / 2 + this.orbitY + Math.sin(this.angle) * 20;
      }

      draw(ctx: CanvasRenderingContext2D, hover: boolean) {
        ctx.beginPath();
        ctx.arc(this.x, this.y, hover ? 3 : 2, 0, Math.PI * 2);
        ctx.fillStyle = hover ? '#00f2fe' : '#ffd700';
        ctx.shadowBlur = hover ? 15 : 10;
        ctx.shadowColor = ctx.fillStyle;
        ctx.fill();
        ctx.shadowBlur = 0;
      }
    }

    const particles = Array.from({ length: 40 }, () => new Particle());

    function drawEgg(ctx: CanvasRenderingContext2D, time: number, hover: boolean, openTime: number) {
      if (!ctx) return;
      
      ctx.clearRect(0, 0, width, height);
      
      // Draw particles behind
      particles.forEach(p => {
        if (Math.cos(p.angle) < 0) p.draw(ctx, hover);
      });

      const cx = width / 2;
      const cy = height / 2;
      
      let yOffset = Math.sin(time * 0.05) * 10;
      let rotation = hover ? time * 0.1 : 0;
      
      let leftHalfX = cx;
      let rightHalfX = cx;
      
      if (isOpened) {
        const progress = Math.min((Date.now() - openTime) / 1000, 1);
        leftHalfX = cx - (progress * 150);
        rightHalfX = cx + (progress * 150);
        rotation = 0;
      }

      ctx.save();
      
      const drawHalf = (xPos: number, isLeft: boolean) => {
        ctx.beginPath();
        ctx.moveTo(xPos, cy - 60 + yOffset);
        ctx.bezierCurveTo(
          xPos + (isLeft ? -70 : 70), cy - 60 + yOffset, 
          xPos + (isLeft ? -80 : 80), cy + 70 + yOffset, 
          xPos, cy + 80 + yOffset
        );
        if (isLeft) {
           ctx.lineTo(xPos, cy - 60 + yOffset);
        } else {
           ctx.lineTo(xPos, cy - 60 + yOffset);
        }
        ctx.closePath();
      };

      // Draw Right Half
      ctx.save();
      ctx.translate(rightHalfX - cx, 0);
      if (!isOpened) {
          ctx.translate(cx, cy + yOffset);
          ctx.rotate(Math.sin(rotation) * 0.1);
          ctx.translate(-cx, -(cy + yOffset));
      }
      drawHalf(cx, false);
      const rightGrad = ctx.createLinearGradient(cx, cy - 60 + yOffset, cx + 80, cy + 80 + yOffset);
      rightGrad.addColorStop(0, hover ? '#ffe55c' : '#ffdf00');
      rightGrad.addColorStop(1, '#b8860b');
      ctx.fillStyle = rightGrad;
      ctx.shadowBlur = hover ? 30 : 15;
      ctx.shadowColor = '#ffd700';
      ctx.fill();
      ctx.restore();

      // Draw Left Half
      ctx.save();
      ctx.translate(leftHalfX - cx, 0);
      if (!isOpened) {
          ctx.translate(cx, cy + yOffset);
          ctx.rotate(Math.sin(rotation) * 0.1);
          ctx.translate(-cx, -(cy + yOffset));
      }
      drawHalf(cx, true);
      const leftGrad = ctx.createLinearGradient(cx - 80, cy - 60 + yOffset, cx, cy + 80 + yOffset);
      leftGrad.addColorStop(0, '#daa520');
      leftGrad.addColorStop(1, hover ? '#ffe55c' : '#ffdf00');
      ctx.fillStyle = leftGrad;
      ctx.shadowBlur = hover ? 30 : 15;
      ctx.shadowColor = '#ffd700';
      ctx.fill();
      ctx.restore();

      // Inside glowing orb
      if (isOpened) {
        const progress = Math.min((Date.now() - openTime) / 1000, 1);
        ctx.beginPath();
        ctx.arc(cx, cy + yOffset, 40 * progress, 0, Math.PI * 2);
        ctx.fillStyle = '#ffffff';
        ctx.shadowBlur = 50 * progress;
        ctx.shadowColor = '#00f2fe';
        ctx.fill();
      }

      ctx.restore();

      // Draw particles in front
      particles.forEach(p => {
        p.update(hover);
        if (Math.cos(p.angle) >= 0) p.draw(ctx, hover);
      });
    }

    function animate() {
      time++;
      drawEgg(eggCtx!, time, isHovered, openTime);
      requestAnimationFrame(animate);
    }

    eggContainer?.addEventListener('mouseenter', () => isHovered = true);
    eggContainer?.addEventListener('mouseleave', () => isHovered = false);
    
    eggContainer?.addEventListener('click', () => {
      if (isOpened) return;
      isOpened = true;
      openTime = Date.now();
      playFanfare();
      
      if (flash) {
        flash.classList.add('active');
        setTimeout(() => {
          flash.style.opacity = '0';
          setTimeout(() => flash.classList.remove('active'), 1000);
        }, 100);
      }

      setTimeout(() => {
        if (eggContainer) eggContainer.style.display = 'none';
        if (certificate) {
          certificate.classList.remove('hidden');
          certificate.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }, 1500);
    });

    animate();
  }

  document.querySelector('.back-link')?.addEventListener('click', (e) => {
    e.preventDefault();
    (window as any).resetHallidayKeys?.();
    window.location.href = '/';
  });
</script>