---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="L'ŒUF D'OR DE HALLIDAY | Mathieu Soussignan" description="Vous avez découvert l'Easter Egg Ultime.">
  <!-- Cinématique RPO - Overlay d'intro -->
  <div class="rp-overlay" id="rpOverlay">
    <canvas id="rpCanvas"></canvas>
    <div class="rp-content" id="rpContent">
      <div class="rp-subtitle" id="rpSubtitle"></div>
      <div class="rp-quote" id="rpQuote"></div>
      <div class="rp-quote-author" id="rpQuoteAuthor"></div>
    </div>
    <div class="rp-skip-container" id="rpSkipContainer">
      <button class="rp-skip-btn" id="rpSkipBtn">SKIP >></button>
      <div class="rp-progress-bar">
        <div class="rp-progress-fill" id="rpProgressFill"></div>
      </div>
    </div>
  </div>

  <div class="sanctuary-container" id="sanctuaryContainer" style="display: none;">
    <div class="stars-bg"></div>
    
    <header class="sanctuary-header">
      <a href="/" class="back-link">← RETOURNER AU MONDE RÉEL</a>
      <h1 class="glowing-title">🥚 L'ŒUF D'OR DE HALLIDAY</h1>
      <p class="subtitle">Félicitations, Gunter ! Tu as réuni les 3 Clés de l'OASIS et découvert l'Easter Egg Ultime.</p>
      <div class="status-badge">🏆 RANG : HÉRITIER UNIQUE DE L'OASIS | COMPLÉTION : 100%</div>
    </header>

    <main>
      <div class="egg-container" id="eggContainer">
        <canvas id="eggCanvas" width="600" height="400"></canvas>
        <div class="click-hint">CLIQUEZ SUR L'ŒUF</div>
      </div>

      <div class="revelation-flash" id="revelationFlash"></div>

      <div class="certificate-container hidden" id="certificateContainer">
        <div class="hologram-effect"></div>
        <div class="certificate-content">
          <h2>HÉREDITÉ DE L'OASIS — CERTIFICAT OFFICIEL</h2>
          <p class="quote">"Merci d'avoir joué à mon jeu. Tu as prouvé ta passion, ta curiosité et ton talent de dev."</p>
          <p class="signature">— James Halliday & Mathieu Soussignan</p>
          
          <div class="vip-actions">
            <a href="mailto:contact@mathieu-soussignan.com?subject=VIP%20OASIS%20Coffee%20Chat" class="vip-btn gold">
              <span class="icon">☕</span> Réserver un café VIP avec Mathieu
            </a>
            <button class="vip-btn cyan" onclick="alert('Badge Légendaire S++ débloqué ! (Imaginaire)')">
              <span class="icon">📜</span> Télécharger le Badge Légendaire S++
            </button>
            <a href="/easter-egg/arcade/" class="vip-btn purple">
              <span class="icon">🕹️</span> Rejouer aux Easter Eggs
            </a>
          </div>
        </div>
      </div>

      <section class="atari-tribute">
        <div class="terminal-box">
          <h3>TRIBUTE : ADVENTURE (1979)</h3>
          <p>
            En 1979, Warren Robinett a créé le premier "Easter Egg" dans le jeu vidéo Adventure sur Atari 2600.
            Mécontent que les créateurs de jeux ne soient pas crédités, il a caché une salle secrète contenant
            le texte "Created by Warren Robinett". C'est cette rébellion créative qui a inspiré l'OASIS et 
            cette quête.
          </p>
          <div class="atari-pixel"></div>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  :root {
    --gold: #ffd700;
    --cyan: #00f2fe;
    --purple: #c561f6;
    --dark-bg: #0a0e17;
  }

  /* ===== CINÉMATIQUE RPO ===== */
  .rp-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: #000;
    z-index: 99999;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transition: opacity 1.5s ease-in-out;
    overflow: hidden;
  }

  .rp-overlay.fade-out {
    opacity: 0;
    pointer-events: none;
  }

  #rpCanvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .rp-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 900px;
    padding: 2rem;
  }

  .rp-subtitle {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    color: var(--gold);
    text-shadow: 0 0 10px var(--gold), 0 0 20px rgba(255, 215, 0, 0.5);
    margin-bottom: 2rem;
    min-height: 1.5rem;
    letter-spacing: 4px;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .rp-subtitle.visible {
    opacity: 1;
  }

  .rp-quote {
    font-family: 'Georgia', 'Times New Roman', serif;
    font-size: 2rem;
    color: #fff;
    text-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
    line-height: 1.5;
    min-height: 3rem;
    margin-bottom: 1.5rem;
    font-style: italic;
    opacity: 0;
    transition: opacity 1s ease;
  }

  .rp-quote.visible {
    opacity: 1;
  }

  .rp-quote .char {
    opacity: 0;
    transition: opacity 0.05s ease;
  }

  .rp-quote .char.revealed {
    opacity: 1;
  }

  .rp-quote-author {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    color: var(--cyan);
    text-shadow: 0 0 10px var(--cyan);
    min-height: 1.5rem;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .rp-quote-author.visible {
    opacity: 1;
  }

  .rp-skip-container {
    position: absolute;
    bottom: 40px;
    width: 100%;
    max-width: 600px;
    padding: 0 2rem;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .rp-skip-btn {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: rgba(255, 255, 255, 0.5);
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.8rem;
    padding: 0.4rem 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    letter-spacing: 2px;
  }

  .rp-skip-btn:hover {
    border-color: rgba(255, 255, 255, 0.8);
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  .rp-progress-bar {
    width: 100%;
    height: 2px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    overflow: hidden;
  }

  .rp-progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--gold), #ff8c00);
    box-shadow: 0 0 10px var(--gold);
    transition: width 0.3s linear;
    border-radius: 2px;
  }

  /* ===== RESTE DU STYLE EXISTANT ===== */
  .sanctuary-container {
    min-height: 100vh;
    background-color: var(--dark-bg);
    color: white;
    font-family: 'Courier New', Courier, monospace;
    position: relative;
    overflow-x: hidden;
    padding: 2rem;
  }

  .stars-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      radial-gradient(2px 2px at 20px 30px, #eee, rgba(0,0,0,0)),
      radial-gradient(2px 2px at 40px 70px, #fff, rgba(0,0,0,0)),
      radial-gradient(2px 2px at 50px 160px, #ddd, rgba(0,0,0,0)),
      radial-gradient(2px 2px at 90px 40px, #fff, rgba(0,0,0,0)),
      radial-gradient(2px 2px at 130px 80px, #fff, rgba(0,0,0,0)),
      radial-gradient(2px 2px at 160px 120px, #ddd, rgba(0,0,0,0));
    background-repeat: repeat;
    background-size: 200px 200px;
    opacity: 0.3;
    z-index: 0;
    pointer-events: none;
    animation: drift 100s linear infinite;
  }

  @keyframes drift {
    from { transform: translateY(0); }
    to { transform: translateY(-200px); }
  }

  .sanctuary-header, main {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .back-link {
    display: inline-block;
    color: var(--cyan);
    text-decoration: none;
    margin-bottom: 2rem;
    text-shadow: 0 0 10px var(--cyan);
    transition: all 0.3s ease;
  }

  .back-link:hover {
    color: #fff;
    text-shadow: 0 0 20px var(--cyan), 0 0 30px var(--cyan);
  }

  .glowing-title {
    font-size: 3rem;
    color: var(--gold);
    text-shadow: 0 0 10px var(--gold), 0 0 20px var(--gold), 0 0 40px #ff8c00;
    margin-bottom: 1rem;
    font-weight: bold;
    letter-spacing: 2px;
  }

  .subtitle {
    font-size: 1.2rem;
    color: #aaa;
    margin-bottom: 2rem;
  }

  .status-badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(197, 97, 246, 0.2);
    border: 1px solid var(--purple);
    border-radius: 4px;
    color: var(--purple);
    font-weight: bold;
    box-shadow: 0 0 15px rgba(197, 97, 246, 0.5);
    margin-bottom: 3rem;
  }

  .egg-container {
    position: relative;
    width: 100%;
    max-width: 600px;
    margin: 0 auto 3rem auto;
    cursor: pointer;
  }

  canvas {
    width: 100%;
    height: auto;
    border-radius: 20px;
    box-shadow: 0 0 50px rgba(255, 215, 0, 0.1);
    transition: box-shadow 0.3s ease;
  }

  .egg-container:hover canvas {
    box-shadow: 0 0 80px rgba(255, 215, 0, 0.3);
  }

  .click-hint {
    position: absolute;
    bottom: -30px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--gold);
    font-size: 0.9rem;
    letter-spacing: 3px;
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  .revelation-flash {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: white;
    z-index: 100;
    opacity: 0;
    pointer-events: none;
    transition: opacity 1s cubic-bezier(0.1, 0.9, 0.2, 1);
  }

  .revelation-flash.active {
    opacity: 1;
    pointer-events: all;
  }

  .certificate-container {
    position: relative;
    background: rgba(255, 215, 0, 0.05);
    border: 2px solid var(--gold);
    padding: 3rem 2rem;
    border-radius: 10px;
    margin-bottom: 4rem;
    box-shadow: 0 0 30px rgba(255, 215, 0, 0.2), inset 0 0 20px rgba(255, 215, 0, 0.1);
    overflow: hidden;
    backdrop-filter: blur(10px);
  }

  .certificate-container.hidden {
    display: none;
  }

  .hologram-effect {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      180deg,
      rgba(0, 242, 254, 0) 0%,
      rgba(0, 242, 254, 0.1) 50%,
      rgba(0, 242, 254, 0) 100%
    );
    background-size: 100% 200%;
    animation: scanline 4s linear infinite;
    pointer-events: none;
  }

  @keyframes scanline {
    0% { background-position: 0 -100%; }
    100% { background-position: 0 200%; }
  }

  .certificate-content h2 {
    color: var(--gold);
    font-size: 1.8rem;
    margin-bottom: 2rem;
    text-shadow: 0 0 10px var(--gold);
  }

  .quote {
    font-size: 1.4rem;
    font-style: italic;
    color: #fff;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .signature {
    text-align: right;
    color: var(--cyan);
    font-size: 1.1rem;
    margin-bottom: 3rem;
  }

  .vip-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }

  @media (min-width: 600px) {
    .vip-actions {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }
  }

  .vip-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.5rem;
    border-radius: 5px;
    font-weight: bold;
    text-decoration: none;
    font-family: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
    border: none;
    background: transparent;
  }

  .vip-btn.gold {
    border: 1px solid var(--gold);
    color: var(--gold);
  }
  .vip-btn.gold:hover {
    background: var(--gold);
    color: var(--dark-bg);
    box-shadow: 0 0 15px var(--gold);
  }

  .vip-btn.cyan {
    border: 1px solid var(--cyan);
    color: var(--cyan);
  }
  .vip-btn.cyan:hover {
    background: var(--cyan);
    color: var(--dark-bg);
    box-shadow: 0 0 15px var(--cyan);
  }

  .vip-btn.purple {
    border: 1px solid var(--purple);
    color: var(--purple);
  }
  .vip-btn.purple:hover {
    background: var(--purple);
    color: white;
    box-shadow: 0 0 15px var(--purple);
  }

  .atari-tribute {
    margin-top: 4rem;
    text-align: left;
  }

  .terminal-box {
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid #333;
    border-left: 4px solid var(--purple);
    padding: 1.5rem;
    border-radius: 4px;
  }

  .terminal-box h3 {
    color: var(--purple);
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }

  .terminal-box p {
    color: #ccc;
    line-height: 1.6;
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .atari-pixel {
    width: 20px;
    height: 20px;
    background: #555;
    animation: blink 2s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { background: #555; }
    50% { background: var(--purple); box-shadow: 0 0 10px var(--purple); }
  }

  @media (max-width: 768px) {
    .rp-quote {
      font-size: 1.2rem;
      padding: 0 1rem;
    }
    .rp-subtitle {
      font-size: 0.7rem;
    }
    .glowing-title {
      font-size: 2rem;
    }
  }
</style>

<script>
  // ============================================================
  // CINÉMATIQUE READY PLAYER ONE
  // ============================================================
  const rpOverlay = document.getElementById('rpOverlay');
  const rpCanvas = document.getElementById('rpCanvas') as HTMLCanvasElement;
  const rpCtx = rpCanvas.getContext('2d');
  const rpSubtitle = document.getElementById('rpSubtitle');
  const rpQuote = document.getElementById('rpQuote');
  const rpQuoteAuthor = document.getElementById('rpQuoteAuthor');
  const rpSkipBtn = document.getElementById('rpSkipBtn');
  const rpProgressFill = document.getElementById('rpProgressFill');
  const sanctuaryContainer = document.getElementById('sanctuaryContainer');

  const rpOverlayEl = rpOverlay!;
  const rpCanvasEl = rpCanvas!;
  const rpCtxEl = rpCtx!;
  const rpSubtitleEl = rpSubtitle!;
  const rpQuoteEl = rpQuote!;
  const rpQuoteAuthorEl = rpQuoteAuthor!;
  const rpSkipBtnEl = rpSkipBtn!;
  const rpProgressFillEl = rpProgressFill!;
  const sanctuaryContainerEl = sanctuaryContainer!;

  if (!rpOverlay || !rpCanvas || !rpCtx || !rpSubtitle || !rpQuote || !rpQuoteAuthor || !rpSkipBtn || !rpProgressFill || !sanctuaryContainer) {
    // Fallback: if elements not found, show sanctuary directly
    if (sanctuaryContainer) sanctuaryContainer.style.display = 'block';
    if (rpOverlay) rpOverlay.style.display = 'none';
  } else {
    // ---- Resize canvas ----
    function resizeCanvas() {
      rpCanvasEl.width = window.innerWidth;
      rpCanvasEl.height = window.innerHeight;
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    // ---- State ----
    let cinematicActive = true;
    let startTime = Date.now();
    const CINEMATIC_DURATION = 14000; // 14 seconds total

    // ---- Subtitles & Quotes sequence ----
    interface CinematicStep {
      subtitle: string;
      quote: string;
      author: string;
      startAt: number; // ms from start
      duration: number; // quote typing duration ms
    }

    const steps: CinematicStep[] = [
      {
        subtitle: "/// SYSTEME DE RECOMPENSE OASIS — PROTOCOLE HALLIDAY //",
        quote: '"La réalité est un triste désert. Mais ici, dans l\'OASIS, tu peux être qui tu veux."',
        author: "— James Halliday, Ready Player One",
        startAt: 500,
        duration: 4000
      },
      {
        subtitle: "/// QUÊTE PRINCIPALE : L'ŒUF DE PÂQUES //",
        quote: '"C\'est le plus grand jeu de chasse au trésor jamais créé. Une quête qui définira toute une génération."',
        author: "— Wade Watts / Parzival, Ready Player One",
        startAt: 5000,
        duration: 4000
      },
      {
        subtitle: "/// FÉLICITATIONS, GUNTER //",
        quote: '"Merci d\'avoir joué à mon jeu. Tu as prouvé ta passion, ta curiosité... et ton génie."',
        author: "— James Halliday, L'Œuf d'Or",
        startAt: 10000,
        duration: 3000
      }
    ];

    // ---- Background Particles (Matrix rain + portal glyphs) ----
    interface RpParticle {
      x: number;
      y: number;
      speed: number;
      char: string;
      size: number;
      opacity: number;
      isGlyph: boolean;
      glow: number;
    }

    const particles: RpParticle[] = [];
    const glyphChars = '☯⚡✦✧❖★☆✦✧⭒⭑⚜🔮🌀🔑🗝️⚙️';
    const matrixChars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789<>/{}[]|&^%$#@!';

    function initParticles() {
      particles.length = 0;
      for (let i = 0; i < 120; i++) {
        const isGlyph = i < 40;
        particles.push({
          x: Math.random() * rpCanvasEl.width,
          y: Math.random() * rpCanvasEl.height,
          speed: 20 + Math.random() * 60,
          char: isGlyph
            ? glyphChars[Math.floor(Math.random() * glyphChars.length)]
            : matrixChars[Math.floor(Math.random() * matrixChars.length)],
          size: isGlyph ? (10 + Math.random() * 20) : (8 + Math.random() * 12),
          opacity: 0.1 + Math.random() * 0.5,
          isGlyph,
          glow: 5 + Math.random() * 20
        });
      }
    }

    function drawParticles(time: number) {
      if (!rpCtxEl) return;
      rpCtxEl.clearRect(0, 0, rpCanvasEl.width, rpCanvasEl.height);

      // Dark gradient background
      const grad = rpCtxEl.createRadialGradient(
        rpCanvasEl.width / 2, rpCanvasEl.height / 2, 0,
        rpCanvasEl.width / 2, rpCanvasEl.height / 2, rpCanvasEl.width * 0.7
      );
      grad.addColorStop(0, '#0a0e17');
      grad.addColorStop(0.5, '#05070a');
      grad.addColorStop(1, '#000000');
      rpCtxEl.fillStyle = grad;
      rpCtxEl.fillRect(0, 0, rpCanvasEl.width, rpCanvasEl.height);

      // Vignette
      const vignette = rpCtxEl.createRadialGradient(
        rpCanvasEl.width / 2, rpCanvasEl.height / 2, rpCanvasEl.height * 0.2,
        rpCanvasEl.width / 2, rpCanvasEl.height / 2, rpCanvasEl.height * 0.8
      );
      vignette.addColorStop(0, 'rgba(0,0,0,0)');
      vignette.addColorStop(1, 'rgba(0,0,0,0.6)');
      rpCtxEl.fillStyle = vignette;
      rpCtxEl.fillRect(0, 0, rpCanvasEl.width, rpCanvasEl.height);

      // Draw particles
      particles.forEach(p => {
        p.y += p.speed * (1 / 60);
        if (p.y > rpCanvasEl.height) {
          p.y = -20;
          p.x = Math.random() * rpCanvasEl.width;
          p.char = p.isGlyph
            ? glyphChars[Math.floor(Math.random() * glyphChars.length)]
            : matrixChars[Math.floor(Math.random() * matrixChars.length)];
        }

        // Sinusoidal horizontal drift
        p.x += Math.sin(time * 0.001 + p.y * 0.01) * 0.5;

        rpCtxEl.font = `${p.size}px "Courier New", monospace`;
        rpCtxEl.shadowBlur = p.glow;
        rpCtxEl.shadowColor = p.isGlyph ? '#ffd700' : '#00f2fe';
        rpCtxEl.fillStyle = p.isGlyph
          ? `rgba(255, 215, 0, ${p.opacity * 0.6})`
          : `rgba(0, 242, 254, ${p.opacity * 0.3})`;
        rpCtxEl.fillText(p.char, p.x, p.y);
        rpCtxEl.shadowBlur = 0;
      });

      // Central portal ring glow
      const cx = rpCanvasEl.width / 2;
      const cy = rpCanvasEl.height / 2;
      const pulseRadius = 100 + Math.sin(time * 0.002) * 30;

      rpCtxEl.beginPath();
      rpCtxEl.arc(cx, cy, pulseRadius, 0, Math.PI * 2);
      rpCtxEl.strokeStyle = `rgba(255, 215, 0, ${0.1 + Math.sin(time * 0.003) * 0.05})`;
      rpCtxEl.lineWidth = 2;
      rpCtxEl.shadowBlur = 40;
      rpCtxEl.shadowColor = '#ffd700';
      rpCtxEl.stroke();
      rpCtxEl.shadowBlur = 0;

      // Inner ring
      rpCtxEl.beginPath();
      rpCtxEl.arc(cx, cy, pulseRadius * 0.5, 0, Math.PI * 2);
      rpCtxEl.strokeStyle = `rgba(0, 242, 254, ${0.08 + Math.sin(time * 0.004) * 0.04})`;
      rpCtxEl.lineWidth = 1;
      rpCtxEl.shadowBlur = 30;
      rpCtxEl.shadowColor = '#00f2fe';
      rpCtxEl.stroke();
      rpCtxEl.shadowBlur = 0;
    }

    initParticles();

    // ---- Typewriter effect for quotes ----
    function typeQuote(text: string, element: HTMLElement, speed: number = 30): Promise<void> {
      return new Promise((resolve) => {
        element.innerHTML = '';
        element.classList.add('visible');
        let i = 0;
        function type() {
          if (i < text.length) {
            const span = document.createElement('span');
            span.className = 'char';
            span.textContent = text.charAt(i);
            element.appendChild(span);
            // Trigger reveal with small delay per character
            requestAnimationFrame(() => span.classList.add('revealed'));
            i++;
            setTimeout(type, speed);
          } else {
            resolve();
          }
        }
        type();
      });
    }

    function clearQuote() {
      rpQuoteEl.innerHTML = '';
      rpQuoteEl.classList.remove('visible');
      rpQuoteAuthorEl.classList.remove('visible');
      rpQuoteAuthorEl.textContent = '';
    }

    // ---- Show subtitle ----
    function showSubtitle(text: string) {
      rpSubtitleEl.textContent = text;
      rpSubtitleEl.classList.add('visible');
    }

    function hideSubtitle() {
      rpSubtitleEl.classList.remove('visible');
    }

    // ---- Cinematic sequence ----
    let animFrameId: number;

    async function runCinematicSequence() {
      for (let i = 0; i < steps.length; i++) {
        if (!cinematicActive) return;
        const step = steps[i];

        // Wait until step start time
        const waitTime = step.startAt - (Date.now() - startTime);
        if (waitTime > 0) {
          await new Promise(r => setTimeout(r, waitTime));
        }
        if (!cinematicActive) return;

        // Show subtitle
        showSubtitle(step.subtitle);

        // Wait a tiny bit before quote
        await new Promise(r => setTimeout(r, 300));
        if (!cinematicActive) return;

        // Type the quote
        await typeQuote(step.quote, rpQuoteEl, 25);
        if (!cinematicActive) return;

        // Show author after a short pause
        await new Promise(r => setTimeout(r, 400));
        if (!cinematicActive) return;

        rpQuoteAuthorEl.textContent = step.author;
        rpQuoteAuthorEl.classList.add('visible');

        // Wait remaining duration of this step
        const elapsedInStep = Date.now() - startTime - step.startAt;
        const remaining = Math.max(0, step.duration - elapsedInStep);
        if (remaining > 0) {
          await new Promise(r => setTimeout(r, remaining));
        }
        if (!cinematicActive) return;

        // Hide for next step (except last)
        if (i < steps.length - 1) {
          clearQuote();
          hideSubtitle();
          await new Promise(r => setTimeout(r, 500));
        }
      }

      // Cinematic complete, transition to sanctuary
      if (cinematicActive) {
        transitionToSanctuary();
      }
    }

    function transitionToSanctuary() {
      cinematicActive = false;
      rpOverlayEl.classList.add('fade-out');
      sanctuaryContainerEl.style.display = 'block';
      // Small delay to let position render
      requestAnimationFrame(() => {
        window.scrollTo(0, 0);
      });
      setTimeout(() => {
        rpOverlayEl.style.display = 'none';
        if (animFrameId) cancelAnimationFrame(animFrameId);
      }, 1500);
    }

    // ---- Progress bar ----
    function updateProgress() {
      if (!cinematicActive) return;
      const elapsed = Date.now() - startTime;
      const progress = Math.min(elapsed / CINEMATIC_DURATION, 1);
      rpProgressFillEl.style.width = `${progress * 100}%`;
      if (progress < 1) {
        requestAnimationFrame(updateProgress);
      }
    }

    // ---- Skip handler ----
    function skipCinematic() {
      if (!cinematicActive) return;
      cinematicActive = false;
      if (animFrameId) cancelAnimationFrame(animFrameId);
      transitionToSanctuary();
    }

    rpSkipBtnEl.addEventListener('click', skipCinematic);

    // ---- Start ----
    function startCinematic() {
      startTime = Date.now();

      // Start particle animation
      function animate() {
        if (!cinematicActive) {
          if (animFrameId) cancelAnimationFrame(animFrameId);
          return;
        }
        drawParticles(Date.now());
        animFrameId = requestAnimationFrame(animate);
      }
      animate();

      // Start progress bar
      updateProgress();

      // Start sequence
      runCinematicSequence();
    }

    // Start after a small delay to ensure everything is loaded
    setTimeout(startCinematic, 200);
  }

  // ============================================================
  // CODE EXISTANT : ŒUF CANVAS + FANFARE
  // ============================================================
  const eggCanvas = document.getElementById('eggCanvas') as HTMLCanvasElement;
  const eggCtx = eggCanvas.getContext('2d');
  const eggContainer = document.getElementById('eggContainer');
  const flash = document.getElementById('revelationFlash');
  const certificate = document.getElementById('certificateContainer');

  if (eggCanvas && eggCtx && eggContainer) {
    let width = eggCanvas.width;
    let height = eggCanvas.height;
    let time = 0;
    let isHovered = false;
    let isOpened = false;
    let openTime = 0;

    let audioCtx: AudioContext | null = null;
    function playFanfare() {
      try {
        audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        
        osc.type = 'square';
        osc.frequency.setValueAtTime(440, audioCtx.currentTime); // A4
        osc.frequency.setValueAtTime(554.37, audioCtx.currentTime + 0.2); // C#5
        osc.frequency.setValueAtTime(659.25, audioCtx.currentTime + 0.4); // E5
        osc.frequency.setValueAtTime(880, audioCtx.currentTime + 0.6); // A5
        
        gain.gain.setValueAtTime(0, audioCtx.currentTime);
        gain.gain.linearRampToValueAtTime(0.1, audioCtx.currentTime + 0.1);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 2);
        
        osc.start();
        osc.stop(audioCtx.currentTime + 2);
      } catch (e) {
        console.log('Audio disabled or not supported.');
      }
    }

    class Particle {
      x: number;
      y: number;
      radius: number;
      angle: number;
      speed: number;
      orbitY: number;

      constructor() {
        this.angle = Math.random() * Math.PI * 2;
        this.radius = 80 + Math.random() * 40;
        this.speed = 0.02 + Math.random() * 0.02;
        this.orbitY = -50 + Math.random() * 100;
        this.x = 0;
        this.y = 0;
      }

      update(hover: boolean) {
        this.angle += hover ? this.speed * 3 : this.speed;
        this.x = width / 2 + Math.cos(this.angle) * this.radius;
        this.y = height / 2 + this.orbitY + Math.sin(this.angle) * 20;
      }

      draw(ctx: CanvasRenderingContext2D, hover: boolean) {
        ctx.beginPath();
        ctx.arc(this.x, this.y, hover ? 3 : 2, 0, Math.PI * 2);
        ctx.fillStyle = hover ? '#00f2fe' : '#ffd700';
        ctx.shadowBlur = hover ? 15 : 10;
        ctx.shadowColor = ctx.fillStyle;
        ctx.fill();
        ctx.shadowBlur = 0;
      }
    }

    const particles = Array.from({ length: 40 }, () => new Particle());

    function drawEgg(ctx: CanvasRenderingContext2D, time: number, hover: boolean, openTime: number) {
      if (!ctx) return;
      
      ctx.clearRect(0, 0, width, height);
      
      // Draw particles behind
      particles.forEach(p => {
        if (Math.cos(p.angle) < 0) p.draw(ctx, hover);
      });

      const cx = width / 2;
      const cy = height / 2;
      
      let yOffset = Math.sin(time * 0.05) * 10;
      let rotation = hover ? time * 0.1 : 0;
      
      let leftHalfX = cx;
      let rightHalfX = cx;
      
      if (isOpened) {
        const progress = Math.min((Date.now() - openTime) / 1000, 1);
        leftHalfX = cx - (progress * 150);
        rightHalfX = cx + (progress * 150);
        rotation = 0;
      }

      ctx.save();
      
      const drawHalf = (xPos: number, isLeft: boolean) => {
        ctx.beginPath();
        ctx.moveTo(xPos, cy - 60 + yOffset);
        ctx.bezierCurveTo(
          xPos + (isLeft ? -70 : 70), cy - 60 + yOffset, 
          xPos + (isLeft ? -80 : 80), cy + 70 + yOffset, 
          xPos, cy + 80 + yOffset
        );
        if (isLeft) {
           ctx.lineTo(xPos, cy - 60 + yOffset);
        } else {
           ctx.lineTo(xPos, cy - 60 + yOffset);
        }
        ctx.closePath();
      };

      // Draw Right Half
      ctx.save();
      ctx.translate(rightHalfX - cx, 0);
      if (!isOpened) {
          ctx.translate(cx, cy + yOffset);
          ctx.rotate(Math.sin(rotation) * 0.1);
          ctx.translate(-cx, -(cy + yOffset));
      }
      drawHalf(cx, false);
      const rightGrad = ctx.createLinearGradient(cx, cy - 60 + yOffset, cx + 80, cy + 80 + yOffset);
      rightGrad.addColorStop(0, hover ? '#ffe55c' : '#ffdf00');
      rightGrad.addColorStop(1, '#b8860b');
      ctx.fillStyle = rightGrad;
      ctx.shadowBlur = hover ? 30 : 15;
      ctx.shadowColor = '#ffd700';
      ctx.fill();
      ctx.restore();

      // Draw Left Half
      ctx.save();
      ctx.translate(leftHalfX - cx, 0);
      if (!isOpened) {
          ctx.translate(cx, cy + yOffset);
          ctx.rotate(Math.sin(rotation) * 0.1);
          ctx.translate(-cx, -(cy + yOffset));
      }
      drawHalf(cx, true);
      const leftGrad = ctx.createLinearGradient(cx - 80, cy - 60 + yOffset, cx, cy + 80 + yOffset);
      leftGrad.addColorStop(0, '#daa520');
      leftGrad.addColorStop(1, hover ? '#ffe55c' : '#ffdf00');
      ctx.fillStyle = leftGrad;
      ctx.shadowBlur = hover ? 30 : 15;
      ctx.shadowColor = '#ffd700';
      ctx.fill();
      ctx.restore();

      // Inside glowing orb
      if (isOpened) {
        const progress = Math.min((Date.now() - openTime) / 1000, 1);
        ctx.beginPath();
        ctx.arc(cx, cy + yOffset, 40 * progress, 0, Math.PI * 2);
        ctx.fillStyle = '#ffffff';
        ctx.shadowBlur = 50 * progress;
        ctx.shadowColor = '#00f2fe';
        ctx.fill();
      }

      ctx.restore();

      // Draw particles in front
      particles.forEach(p => {
        p.update(hover);
        if (Math.cos(p.angle) >= 0) p.draw(ctx, hover);
      });
    }

    function animate() {
      time++;
      drawEgg(eggCtx!, time, isHovered, openTime);
      requestAnimationFrame(animate);
    }

    eggContainer?.addEventListener('mouseenter', () => isHovered = true);
    eggContainer?.addEventListener('mouseleave', () => isHovered = false);
    
    eggContainer?.addEventListener('click', () => {
      if (isOpened) return;
      isOpened = true;
      openTime = Date.now();
      playFanfare();
      
      if (flash) {
        flash.classList.add('active');
        setTimeout(() => {
          flash.style.opacity = '0';
          setTimeout(() => flash.classList.remove('active'), 1000);
        }, 100);
      }

      setTimeout(() => {
        if (eggContainer) eggContainer.style.display = 'none';
        if (certificate) {
          certificate.classList.remove('hidden');
          certificate.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }, 1500);
    });

    animate();
  }

  document.querySelector('.back-link')?.addEventListener('click', (e) => {
    e.preventDefault();
    (window as any).resetHallidayKeys?.();
    window.location.href = '/';
  });
</script>