---
import Icon from "./Icon.astro";
const currentYear = new Date().getFullYear();
---

<footer class="god-footer">
  <div class="footer-container wrapper">
    <div class="footer-brand">
      <a href="/" class="footer-title">
        <Icon icon="terminal-window" color="var(--accent-regular)" size="1.6em" gradient />
        <span>Mathieu Soussignan</span>
      </a>
      <p class="footer-tagline">
        Data Engineer & Développeur IA chez <strong>Keyrus</strong>. Concepteur de solutions intelligentes & architectures Data d'élite.
      </p>
      <div class="footer-status-pill">
        <span class="status-dot"></span>
        <span>Data Engineer & IA @ Keyrus • Aix / Marseille</span>
      </div>
    </div>

    <div class="footer-nav">
      <h4 class="footer-col-title">Navigation</h4>
      <ul>
        <li><a href="/">Accueil</a></li>
        <li><a href="/work/">Projets</a></li>
        <li><a href="/about/">À propos</a></li>
        <li><a href="mailto:contact@mathieu-soussignan.com">Contact</a></li>
      </ul>
    </div>

    <div class="footer-social-col">
      <h4 class="footer-col-title">Réseaux & Code</h4>
      <div class="social-links">
        <a href="https://github.com/Mathieu-Soussignan" target="_blank" rel="noopener noreferrer" class="social-link glass-card">
          <Icon icon="github-logo" size="1.2em" />
          <span>GitHub</span>
        </a>
        <a href="https://www.linkedin.com/in/mathieu-soussignan-007a07158/" target="_blank" rel="noopener noreferrer" class="social-link glass-card">
          <Icon icon="linkedin-logo" size="1.2em" />
          <span>LinkedIn</span>
        </a>
      </div>
    </div>
  </div>

  <div class="footer-bottom-bar">
    <div class="wrapper bottom-content">
      <p>&copy; {currentYear} Mathieu Soussignan • Conçu & développé avec Astro, IA & Passion</p>
      <p class="footer-secret-hint" title="Code Konami : ↑ ↑ ↓ ↓ ← → ← → B A">
        <span class="hint-glyph">🎮</span> <span class="hint-text">Secret Konami : ↑ ↑ ↓ ↓ ← → ← → B A</span>
      </p>
      <a href="#" class="top-scroll-btn" id="scroll-to-top" title="Haut de page">
        <span>Remonter</span> ↑
      </a>
    </div>
  </div>
  <!-- 
    ██████╗ ███████╗██╗   ██╗    ███████╗███████╗ ██████╗██████╗ ███████╗████████╗
    ██╔══██╗██╔════╝██║   ██║    ██╔════╝██╔════╝██╔════╝██╔══██╗██╔════╝╚══██╔══╝
    ██║  ██║█████╗  ██║   ██║    ███████╗█████╗  ██║     ██████╔╝█████╗     ██║   
    ██║  ██║██╔══╝  ╚██╗ ██╔╝    ╚════██║██╔══╝  ██║     ██╔══██╗██╔══╝     ██║   
    ██████╔╝███████╗ ╚████╔╝     ███████║███████╗╚██████╗██║  ██║███████╗   ██║   
    ╚═════╝ ╚══════╝  ╚═══╝      ╚══════╝╚══════╝ ╚═════╝╚═╝  ╚═╝╚══════╝   ╚═╝   
    
    Tu inspectes le code source ? Tu as l'instinct d'un vrai dev. 🔍
    Indice 1: Le terminal sait des choses qu'il ne dit pas... essaye 'sudo hack' ou 'konami'.
    Indice 2: Séquence 7 lettres (M-A-T-H-I-E-U). Tape-les au clavier.
    Indice 3: Konami Code = ↑ ↑ ↓ ↓ ← → ← → B A (Mode Anti-Gravité).
    Indice 4: 7 clics rapides sur la photo de profil (Carte TCG Légendaire).
    Indice 5: Dans la console (F12), tape 'oasis()' pour lancer le saut VR.
  -->
</footer>

<script>
  const scrollTopBtn = document.getElementById('scroll-to-top');
  scrollTopBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>

<style>
  .god-footer {
    display: flex;
    flex-direction: column;
    margin-top: 5rem;
    background: rgba(10, 14, 23, 0.95);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-body);
  }

  .footer-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-top: 4rem;
    padding-bottom: 3rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 40ch;
  }

  .footer-title {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-brand);
    font-size: var(--text-xl);
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
  }

  .footer-tagline {
    color: var(--gray-300);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .footer-status-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: #27c93f;
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    background: rgba(39, 201, 63, 0.1);
    border: 1px solid rgba(39, 201, 63, 0.3);
    width: fit-content;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #27c93f;
    box-shadow: 0 0 8px #27c93f;
  }

  .footer-col-title {
    font-family: var(--font-brand);
    font-size: var(--text-base);
    color: #ffffff;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }

  .footer-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-nav a {
    color: var(--gray-300);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color 0.2s ease;
  }

  .footer-nav a:hover {
    color: #00f2fe;
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1.2rem;
    border-radius: 0.75rem;
    color: var(--gray-100);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
    transition: all 0.25s ease;
    width: fit-content;
  }

  .social-link:hover {
    color: #ffffff;
    background: rgba(197, 97, 246, 0.25) !important;
    border-color: rgba(197, 97, 246, 0.6) !important;
    transform: translateY(-2px);
  }

  /* BOTTOM BAR */
  .footer-bottom-bar {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: 1.5rem 0;
    background: rgba(9, 11, 17, 0.98);
  }

  .bottom-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-sm);
    color: var(--gray-200);
  }

  .top-scroll-btn {
    color: #00f2fe;
    text-decoration: none;
    font-weight: 600;
    font-size: var(--text-sm);
    transition: all 0.2s ease;
  }

  .top-scroll-btn:hover {
    color: #c561f6;
    transform: translateY(-2px);
  }

  /* Easter Egg Hint */
  .footer-secret-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.12);
    cursor: default;
    transition: all 0.4s ease;
    user-select: none;
  }

  .footer-secret-hint:hover {
    color: rgba(197, 97, 246, 0.6);
  }

  .footer-secret-hint:hover .hint-glyph {
    animation: hintBounce 0.6s ease;
  }

  @keyframes hintBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }

  .hint-text {
    letter-spacing: 0.02em;
  }

  @media (min-width: 50em) {
    .footer-container {
      grid-template-columns: 2fr 1fr 1fr;
    }

    .bottom-content {
      flex-direction: row;
    }
  }
</style>
