---
import { getCollection } from "astro:content";
import Icon from "./Icon.astro";
import { buildPortfolioKnowledge } from "../lib/copilot/knowledge";

// Reuse the existing `work` content collection as the source of truth for the
// copilot knowledge base — nothing is duplicated.
const knowledge = buildPortfolioKnowledge(await getCollection("work"));
---

<div class="terminal-container glass-card">
  <div class="terminal-header">
    <div class="window-buttons">
      <span class="btn close"></span>
      <span class="btn minimize"></span>
      <span class="btn maximize"></span>
    </div>
    <div class="terminal-title">
      <Icon icon="terminal-window" size="1.2em" />
      mathieu@keyrus: ~ (zsh)
    </div>
    <div class="terminal-status">
      <span class="status-dot"></span> LIVE
    </div>
  </div>

  <div class="terminal-body" id="terminal-body">
    <div class="terminal-welcome">
      <p class="welcome-text">Bienvenue sur le terminal de <span class="highlight">Mathieu Soussignan</span> v2.6.0</p>
      <p class="sub-text">Tapez <span class="cmd-shortcut">'help'</span> ou cliquez sur une commande ci-dessous pour explorer.</p>
    </div>

    <div id="terminal-history"></div>
    <div class="sr-only" id="copilot-live" aria-live="polite"></div>

    <form class="terminal-input-row" id="terminal-form">
      <span class="prompt">mathieu@keyrus:~$</span>
      <input
        type="text"
        id="terminal-input"
        class="terminal-input"
        autocomplete="off"
        spellcheck="false"
        placeholder="Entrez une commande (ex: whoami, skills, projects)..."
      />
    </form>
  </div>

      <div class="terminal-quick-actions">
        <button type="button" class="quick-cmd" data-cmd="ask">ask</button>
        <button type="button" class="quick-cmd" data-cmd="whoami">whoami</button>
        <button type="button" class="quick-cmd" data-cmd="skills">skills</button>
        <button type="button" class="quick-cmd" data-cmd="projects">projects</button>
        <button type="button" class="quick-cmd" data-cmd="contact">contact</button>
        <button type="button" class="quick-cmd" data-cmd="matrix">matrix</button>
        <button type="button" class="quick-cmd" data-cmd="mario">mario</button>
        <button type="button" class="quick-cmd" data-cmd="clear">clear</button>
      </div>
</div>

<script type="application/json" id="copilot-knowledge" set:html={JSON.stringify(knowledge).replace(/</g, "\\u003c")}></script>

<script>
  import { createHybridCopilotEngine } from "../lib/copilot/provider";
  import { renderCopilotAnswer, renderCopilotSuggestions } from "../lib/copilot/render";
  import type { PortfolioKnowledge } from "../lib/copilot/types";

  const form = document.getElementById("terminal-form") as HTMLFormElement;
  const input = document.getElementById("terminal-input") as HTMLInputElement;
  const history = document.getElementById("terminal-history") as HTMLElement;
  const body = document.getElementById("terminal-body") as HTMLElement;
  const quickBtns = document.querySelectorAll(".quick-cmd");
  const copilotLive = document.getElementById("copilot-live") as HTMLElement | null;

  const kbElement = document.getElementById("copilot-knowledge");
  const kb = (kbElement ? JSON.parse(kbElement.textContent || "{}") : {}) as PortfolioKnowledge;
  const copilot = createHybridCopilotEngine(kb);

  const commands: Record<string, string> = {
    whoami: `
      <div class="cmd-output">
        <p><strong>Mathieu Soussignan</strong></p>
        <p><strong>Rôle :</strong> Data Engineer & Développeur IA chez <strong>Keyrus</strong> (Aix-en-Provence)</p>
        <p><strong>Formation :</strong> Développeur IA (Simplon / Microsoft) & Développeur Web Fullstack</p>
        <p><strong>Localisation :</strong> Marseille / Aix-en-Provence</p>
        <p><strong>Spécialités :</strong> Data Engineering (ETL, SQL, Python), IA/NLP (PyTorch, Scikit-Learn), Web FullStack (React, FastAPI, Astro)</p>
      </div>
    `,
    skills: `
      <div class="cmd-output">
        <p class="skill-head"><strong>LANGAGES & DATA :</strong></p>
        <p>Python • SQL • JavaScript / TypeScript • HTML5 / CSS3</p>
        <p class="skill-head"><strong>IA, ML & DATA ENGINEERING :</strong></p>
        <p>Pipelines ETL • Pandas • NumPy • Scikit-Learn • PyTorch • LLM & NLP • PostgreSQL</p>
        <p class="skill-head"><strong>FRAMEWORKS & OUTILS :</strong></p>
        <p>React • FastAPI • Flask • Astro • Docker • Git/GitHub • Tailwind CSS</p>
      </div>
    `,
    projects: `
      <div class="cmd-output">
        <p><strong>Projets phares récents :</strong></p>
        <p>1. <a href="/work/creatorcomptability/" class="term-link">CreatorComptability</a> ➔ SaaS de comptabilité automatisée pour créateurs avec IA (React + FastAPI)</p>
        <p>2. <a href="/work/predict-cars/" class="term-link">Prédict Car</a> ➔ Estimation de prix automobile par Machine Learning (Random Forest)</p>
        <p>3. <a href="/work/synthese-ai/" class="term-link">Résumeur de Texte IA</a> ➔ NLP & résumé automatique d'articles (Flask + Sumy)</p>
        <p>Tapez <a href="/work/" class="term-link">/work/</a> dans votre navigateur pour voir la liste complète.</p>
      </div>
    `,
    contact: `
      <div class="cmd-output">
        <p><strong>Contact direct :</strong></p>
        <p>Email : <a href="mailto:contact@mathieu-soussignan.com" class="term-link">contact@mathieu-soussignan.com</a></p>
        <p>LinkedIn : <a href="https://www.linkedin.com/in/mathieu-soussignan-007a07158/" target="_blank" class="term-link">mathieu-soussignan</a></p>
        <p>GitHub : <a href="https://github.com/Mathieu-Soussignan" target="_blank" class="term-link">Mathieu-Soussignan</a></p>
      </div>
    `,
    help: `
      <div class="cmd-output">
        <p><strong>Commandes disponibles :</strong></p>
        <p>• <span class="cmd">ask</span> ➔ Poser une question au Copilot IA du portfolio</p>
        <p>• <span class="cmd">whoami</span> ➔ Mon profil et rôle actuel chez Keyrus</p>
        <p>• <span class="cmd">skills</span> ➔ Mes compétences techniques Data, IA & Web</p>
        <p>• <span class="cmd">projects</span> ➔ Mes projets récents et applications SaaS</p>
        <p>• <span class="cmd">contact</span> ➔ Mes coordonnées et réseaux sociaux</p>
        <p>• <span class="cmd">matrix</span> ➔ Déclencher la pluie numérique Matrix</p>
        <p>• <span class="cmd">konami</span> ➔ Révéler le code secret légendaire (Anti-Gravité)</p>
        <p>• <span class="cmd">clear</span> ➔ Effacer le terminal</p>
        <p style="margin-top:0.5rem; color:#444c5e; font-size:0.75rem; font-style:italic;">// Psst... essaye 'konami' ou 'sudo hack' pour débloquer les secrets !</p>
      </div>
    `,
    konami: `
      <div class="cmd-output" style="border-left-color:#ff006e; background:rgba(255,0,110,0.05);">
        <p style="color:#ff006e; font-weight:bold;">🎮 CODE KONAMI DECOUVERT !</p>
        <p style="margin-top:0.4rem;">Combinaison de touches à taper au clavier (hors terminal) :</p>
        <p style="font-size:1.1rem; color:#00f2fe; font-weight:bold; letter-spacing:0.1em; margin:0.4rem 0;">↑ ↑ ↓ ↓ ← → ← → B A</p>
        <p style="color:var(--gray-300); font-size:0.8rem;">(Flèche Haut, Haut, Bas, Bas, Gauche, Droite, Gauche, Droite, B, A)</p>
        <p style="color:#00ff66; margin-top:0.4rem; font-size:0.85rem;">⚡ Effet : Active le Mode Anti-Gravité & le HUD RPG !</p>
      </div>
    `,
    cheat: `
      <div class="cmd-output" style="border-left-color:#ff006e; background:rgba(255,0,110,0.05);">
        <p style="color:#ff006e; font-weight:bold;">🎮 CODE KONAMI DECOUVERT !</p>
        <p style="margin-top:0.4rem;">Combinaison de touches à taper au clavier :</p>
        <p style="font-size:1.1rem; color:#00f2fe; font-weight:bold; letter-spacing:0.1em; margin:0.4rem 0;">↑ ↑ ↓ ↓ ← → ← → B A</p>
        <p style="color:#00ff66; margin-top:0.4rem; font-size:0.85rem;">⚡ Effet : Active le Mode Anti-Gravité & le HUD RPG !</p>
      </div>
    `,
    matrix: '__MATRIX_RAIN__',
  };

  // === MATRIX RAIN — Full Screen Canvas Animation ===
  function launchMatrixRain() {
    // Create overlay
    const overlay = document.createElement('div');
    overlay.id = 'matrix-rain-overlay';
    overlay.style.cssText = `
      position: fixed; inset: 0; z-index: 999999;
      background: #000000; cursor: pointer;
      opacity: 0; transition: opacity 0.5s ease;
    `;

    const canvas = document.createElement('canvas');
    canvas.style.cssText = 'display: block; width: 100%; height: 100%;';
    overlay.appendChild(canvas);

    // Message overlay
    const msg = document.createElement('div');
    msg.style.cssText = `
      position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%);
      color: #00ff66; font-family: 'Fira Code', monospace; font-size: 0.85rem;
      text-align: center; opacity: 0.7; text-shadow: 0 0 10px #00ff66;
      pointer-events: none;
    `;
    msg.textContent = '「 Wake up, Neo... The Data Matrix has you. 」 — Cliquez pour quitter';
    overlay.appendChild(msg);

    document.body.appendChild(overlay);
    requestAnimationFrame(() => { overlay.style.opacity = '1'; });

    const ctx = canvas.getContext('2d')!;

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    // Matrix characters — mix of Katakana, Latin, numbers, symbols
    const matrixChars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲンABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%^&*<>{}[]|/\\';
    const fontSize = 14;
    let columns = Math.floor(canvas.width / fontSize);
    let drops: number[] = [];

    function initDrops() {
      columns = Math.floor(canvas.width / fontSize);
      drops = new Array(columns).fill(0).map(() => Math.random() * -100);
    }
    initDrops();

    let animId: number;
    let running = true;

    function drawFrame() {
      if (!running) return;

      // Semi-transparent black to create trail effect
      ctx.fillStyle = 'rgba(0, 0, 0, 0.05)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      ctx.font = `${fontSize}px 'Fira Code', monospace`;

      for (let i = 0; i < drops.length; i++) {
        // Random character
        const char = matrixChars[Math.floor(Math.random() * matrixChars.length)];
        const x = i * fontSize;
        const y = drops[i] * fontSize;

        // Head of the column is brighter white-green
        if (Math.random() > 0.975) {
          ctx.fillStyle = '#ffffff';
        } else {
          // Varying green shades
          const brightness = Math.random() * 100 + 155;
          ctx.fillStyle = `rgb(0, ${brightness}, ${Math.floor(brightness * 0.4)})`;
        }

        ctx.fillText(char, x, y);

        // Reset drop when it falls off screen + random restart
        if (y > canvas.height && Math.random() > 0.975) {
          drops[i] = 0;
        }
        drops[i]++;
      }

      animId = requestAnimationFrame(drawFrame);
    }

    drawFrame();

    // Close on click or keypress
    function closeMatrix() {
      running = false;
      cancelAnimationFrame(animId);
      overlay.style.opacity = '0';
      setTimeout(() => {
        overlay.remove();
        window.removeEventListener('resize', resize);
      }, 500);
      document.removeEventListener('keydown', closeMatrix);
    }

    overlay.addEventListener('click', closeMatrix);
    document.addEventListener('keydown', closeMatrix);

    // Auto-close after 10 seconds
    setTimeout(() => {
      if (running) closeMatrix();
    }, 10000);

    // Terminal output
    const row = document.createElement('div');
    row.className = 'history-item';
    row.innerHTML = `
      <div class="history-cmd"><span class="prompt">mathieu@keyrus:~$</span> <span class="cmd-text" style="color:#00ff66;">matrix</span></div>
      <div class="cmd-output matrix-rain">
        <p>🟢 INITIATING MATRIX RAIN PROTOCOL...</p>
        <p>🟢 "Wake up, Neo... The Data Matrix has you." 🚀</p>
      </div>
    `;
    history.appendChild(row);
    body.scrollTop = body.scrollHeight;
  }

  // === SECRET COMMANDS (Easter Egg #1) ===
  const SECRET_COMMANDS = ["sudo hack", "matrix --godmode"];

  function runHackAnimation() {
    input.disabled = true;
    const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789@#$%^&*!?><{}[]|/\\";
    const targetMsg = "ACCESS GRANTED — BIENVENUE DANS LA MATRICE";
    const row = document.createElement("div");
    row.className = "history-item";

    const promptSpan = `<div class="history-cmd"><span class="prompt">mathieu@keyrus:~$</span> <span class="cmd-text" style="color:#00ff66;">sudo hack</span></div>`;
    const outputDiv = document.createElement("div");
    outputDiv.className = "cmd-output hack-output";
    outputDiv.style.cssText = "color:#00ff66; border-left-color:#00ff66; background:rgba(0,255,102,0.05); font-family:'Fira Code',monospace; white-space:pre;";

    row.innerHTML = promptSpan;
    row.appendChild(outputDiv);
    history.appendChild(row);
    body.scrollTop = body.scrollHeight;

    // Phase 1: Rapid random lines (1.5s)
    const hackLines = [
      "[SYS] Initializing kernel bypass...",
      "[NET] Routing through encrypted tunnel ███████ OK",
      "[AUTH] Brute-forcing access token... ██░░░░░░░░",
      "[AUTH] Brute-forcing access token... █████░░░░░",
      "[AUTH] Brute-forcing access token... ████████░░",
      "[AUTH] Brute-forcing access token... ██████████ CRACKED",
      "[DB] Injecting payload → 0x7F3A9C2E...",
      "[DECRYPT] Decoding security layer 1/3... ✓",
      "[DECRYPT] Decoding security layer 2/3... ✓",
      "[DECRYPT] Decoding security layer 3/3... ✓",
      "[FIREWALL] Bypassed ✓",
      "[STATUS] Root access obtained",
    ];

    let lineIdx = 0;
    const lineInterval = setInterval(() => {
      if (lineIdx >= hackLines.length) {
        clearInterval(lineInterval);
        // Phase 2: Decryption reveal of final message
        let resolved = new Array(targetMsg.length).fill(false);
        let display = Array.from(targetMsg).map(() => chars[Math.floor(Math.random() * chars.length)]);

        const decryptLine = document.createElement("p");
        decryptLine.style.cssText = "margin-top:0.75rem; font-size:1.1rem; font-weight:bold; color:#00ff66; text-shadow:0 0 10px #00ff66;";
        outputDiv.appendChild(decryptLine);

        let decryptTick = 0;
        const decryptInterval = setInterval(() => {
          // Resolve 2-3 characters per tick
          const toResolve = Math.min(3, targetMsg.length - resolved.filter(Boolean).length);
          for (let r = 0; r < toResolve; r++) {
            const unresolvedIndices = resolved.map((v, i) => (!v ? i : -1)).filter(i => i >= 0);
            if (unresolvedIndices.length === 0) break;
            const pick = unresolvedIndices[Math.floor(Math.random() * unresolvedIndices.length)];
            resolved[pick] = true;
            display[pick] = targetMsg[pick];
          }
          // Scramble unresolved
          display = display.map((_c, i) => resolved[i] ? targetMsg[i] : chars[Math.floor(Math.random() * chars.length)]);
          decryptLine.textContent = `> ${display.join("")}_`;
          decryptTick++;
          body.scrollTop = body.scrollHeight;

          if (resolved.every(Boolean)) {
            clearInterval(decryptInterval);
            decryptLine.textContent = `> ${targetMsg} ✓`;

            // Phase 3: Redirect countdown
            const redirectLine = document.createElement("p");
            redirectLine.style.cssText = "margin-top:0.5rem; color:#00f2fe; animation: pulse 0.5s infinite alternate;";
            redirectLine.textContent = "[REDIRECT] Ouverture du portail en 2s...";
            outputDiv.appendChild(redirectLine);
            body.scrollTop = body.scrollHeight;

            setTimeout(() => {
              redirectLine.textContent = "[REDIRECT] Ouverture du portail en 1s...";
              setTimeout(() => {
                window.location.href = "/easter-egg/hack/";
              }, 1000);
            }, 1000);
          }
        }, 60);

        return;
      }
      const p = document.createElement("p");
      p.textContent = hackLines[lineIdx];
      p.style.opacity = "0";
      p.style.animation = "fadeInLine 0.15s forwards";
      outputDiv.appendChild(p);
      body.scrollTop = body.scrollHeight;
      lineIdx++;
    }, 130);
  }

  function executeCommand(cmd: string) {
    const cleanCmd = cmd.trim().toLowerCase();
    if (!cleanCmd) return;

    if (cleanCmd === "clear") {
      history.innerHTML = "";
      input.value = "";
      setCopilotMode(false);
      return;
    }

    // AI Portfolio Copilot — `ask` / `ai` command.
    const copilotCmd = parseCopilotCommand(cmd);
    if (copilotCmd.invoke) {
      input.value = "";
      if (copilotCmd.question) {
        runCopilot(copilotCmd.question);
      } else {
        openCopilotPrompt();
      }
      return;
    }

    // Check for secret commands
    if (SECRET_COMMANDS.includes(cleanCmd)) {
      input.value = "";
      runHackAnimation();
      return;
    }

    // Matrix rain — full screen animation
    if (cleanCmd === "matrix") {
      input.value = "";
      launchMatrixRain();
      return;
    }

    // Mario — redirect to hidden level
    if (cleanCmd === "mario" || cleanCmd === "super-mario" || cleanCmd === "mathio") {
      input.value = "";
      const row = document.createElement("div");
      row.className = "history-item";
      row.innerHTML = `
        <div class="history-cmd"><span class="prompt">mathieu@keyrus:~$</span> <span class="cmd-text" style="color:#ff006e;">${cleanCmd}</span></div>
        <div class="cmd-output" style="border-left-color:#e52521; background:rgba(229,37,33,0.05);">
          <p>🍄 <strong style="color:#e52521;">SUPER MATHIO</strong> — Chargement du niveau secret...</p>
          <p style="color:#fbd000; font-size:0.8rem;">"It's-a me, Mathio!" 🏁</p>
        </div>
      `;
      history.appendChild(row);
      body.scrollTop = body.scrollHeight;
      setTimeout(() => {
        window.location.href = '/easter-egg/mario/';
      }, 1500);
      return;
    }

    const row = document.createElement("div");
    row.className = "history-item";

    const promptSpan = `<div class="history-cmd"><span class="prompt">mathieu@keyrus:~$</span> <span class="cmd-text">${cleanCmd}</span></div>`;
    let responseHTML = commands[cleanCmd] || `<div class="cmd-output error">Commande inconnue: '${cleanCmd}'. Tapez 'help' pour la liste des commandes.</div>`;

    row.innerHTML = promptSpan + responseHTML;
    history.appendChild(row);
    input.value = "";
    body.scrollTop = body.scrollHeight;
  }

  // === AI PORTFOLIO COPILOT ===
  let copilotMode = false;

  function setCopilotMode(active: boolean) {
    copilotMode = active;
    const container = document.querySelector(".terminal-container");
    container?.classList.toggle("copilot-active", active);
    input.placeholder = active
      ? "Posez une question (ex: Quels sont mes projets IA ?)"
      : "Entrez une commande (ex: whoami, skills, projects)...";
  }

  function parseCopilotCommand(cmd: string): { invoke: boolean; question: string | null } {
    const match = cmd.trim().match(/^(ask|ai)(?:\s+([\s\S]*))?$/i);
    if (!match) return { invoke: false, question: null };
    let rest = (match[2] ?? "").trim();
    if (!rest) return { invoke: true, question: null };
    if ((rest.startsWith('"') && rest.endsWith('"')) || (rest.startsWith("'") && rest.endsWith("'"))) {
      rest = rest.slice(1, -1).trim();
    } else {
      rest = rest.replace(/^["']/, "").trim();
    }
    return { invoke: true, question: rest || null };
  }

  function scrollTerminal() {
    body.scrollTop = body.scrollHeight;
  }

  function announceCopilot(message: string) {
    if (copilotLive) copilotLive.textContent = message;
  }

  function runCopilot(question: string) {
    const query = question.trim();
    if (!query) {
      openCopilotPrompt();
      return;
    }
    input.value = "";

    const row = document.createElement("div");
    row.className = "history-item";

    const promptLine = document.createElement("div");
    promptLine.className = "history-cmd";
    const promptSpan = document.createElement("span");
    promptSpan.className = "prompt";
    promptSpan.textContent = "mathieu@keyrus:~$";
    const cmdSpan = document.createElement("span");
    cmdSpan.className = "cmd-text copilot-cmd";
    cmdSpan.textContent = "ask";
    const questionSpan = document.createElement("span");
    questionSpan.className = "copilot-question";
    questionSpan.textContent = ` "${query}"`;
    promptLine.append(promptSpan, document.createTextNode(" "), cmdSpan, questionSpan);
    row.appendChild(promptLine);

    const thinking = document.createElement("div");
    thinking.className = "copilot-thinking";
    thinking.setAttribute("role", "status");
    thinking.setAttribute("aria-label", "Analyse en cours");
    row.appendChild(thinking);
    history.appendChild(row);
    scrollTerminal();

    const finish = async () => {
      const response = await copilot.ask(query);
      thinking.remove();
      row.appendChild(renderCopilotAnswer(response));
      announceCopilot(response.headline);
      if (response.suggestions.length > 0) {
        row.appendChild(renderCopilotSuggestions(response.suggestions, (next) => runCopilot(next)));
      }
      scrollTerminal();
    };

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      finish();
      return;
    }

    const steps = ["Analyse du profil…", "Recherche des projets pertinents…", "Génération de la réponse…"];
    const stepEl = document.createElement("p");
    stepEl.textContent = `◌ ${steps[0]}`;
    thinking.appendChild(stepEl);

    let stepIndex = 0;
    const interval = window.setInterval(() => {
      stepIndex++;
      if (stepIndex >= steps.length) {
        window.clearInterval(interval);
        stepEl.textContent = `✓ Analyse terminée`;
        window.setTimeout(finish, 160);
      } else {
        stepEl.textContent = `✓ ${steps[stepIndex - 1]}  →  ◌ ${steps[stepIndex]}`;
      }
    }, 240);
  }

  function openCopilotPrompt() {
    setCopilotMode(true);

    const row = document.createElement("div");
    row.className = "history-item";

    const promptLine = document.createElement("div");
    promptLine.className = "history-cmd";
    promptLine.innerHTML = `<span class="prompt">mathieu@keyrus:~$</span> <span class="cmd-text copilot-cmd">ask</span>`;
    row.appendChild(promptLine);

    const intro = document.createElement("div");
    intro.className = "copilot-intro";
    const introText = document.createElement("p");
    introText.textContent =
      "AI Portfolio Copilot activé — posez une question sur le profil, les compétences ou les projets de Mathieu. (tapez 'exit' pour quitter)";
    intro.appendChild(introText);
    row.appendChild(intro);

    row.appendChild(renderCopilotSuggestions(copilot.suggest(), (q) => runCopilot(q)));

    history.appendChild(row);
    announceCopilot("Copilot activé. Posez une question sur le portfolio.");
    input.value = "";
    input.focus();
    scrollTerminal();
  }

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const value = input.value;
    if (copilotMode) {
      const trimmed = value.trim();
      if (/^(exit|quit|clear|help|skills|projects|contact|whoami|matrix|mario)$/i.test(trimmed)) {
        setCopilotMode(false);
        executeCommand(trimmed);
        return;
      }
      runCopilot(value);
      return;
    }
    executeCommand(value);
  });

  quickBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const cmd = btn.getAttribute("data-cmd");
      if (cmd) executeCommand(cmd);
    });
  });
</script>

<style>
  .terminal-container {
    width: 100%;
    max-width: 680px;
